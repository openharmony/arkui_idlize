package heir_components;
import root_components.CommonMethod as CommonMethod;
[Component]
interface ButtonAttribute: CommonMethod {
    [CommonMethod]
    attribute (String or undefined) label;
};
[Synthetic]
callback Callback_Void = void ();
[ComponentInterface]
interface ButtonInterface {
    [Annotations=memo, CallSignature]
    ButtonAttribute invoke(optional Callback_Void content_);
    [Annotations=memo, CallSignature]
    ButtonAttribute invoke(String label, optional Callback_Void content_);
};