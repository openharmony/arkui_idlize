package primitives;
interface Iface {
    void foo(any value);
    this foo();
    void foo(Object value);
    void foo(Object value);
    void foo((String or undefined) value);
    void foo(String value);
    void foo(number value);
    void foo(i32 value);
    void foo(f32 value);
    void foo(i64 value);
    void foo(i16 value);
    void foo(f64 value);
    void foo(boolean value);
    void foo(u16 value);
    void foo(sequence<String> value);
    void foo();
    void foo(record<String, number> value);
    void foo(date value);
    void foo(buffer value);
    void foo(String value);
    void foo(String value);
    void foo((String or undefined) value);
    any bar01();
    Object bar02();
    Object bar03();
    (String or undefined) bar04();
    String bar05();
    number bar06();
    i32 bar07();
    f32 bar08();
    i64 bar00();
    i16 bar10();
    void bar11();
    boolean bar12();
    u16 bar13();
    sequence<String> bar14();
    void bar15();
    date bar16();
    buffer bar17();
    String bar18();
    String bar19();
    (String or undefined) bar20();
};