{
  "name": "@idlizer/runner",
  "version": "2.1.10+devel",
  "description": "",
  "main": "lib/index.js",
  "bin": "lib/index.js",
  "files": [
    "lib/*.js",
    "patches/**/*",
    "configs/**/*",
    "interop-types/**/*"
  ],
  "license": "Apache-2.0",
  "keywords": [],
  "dependencies": {
    "@idlizer/interfaces": "2.1.10+devel",
    "commander": "^10.0.0"
  },
  "devDependencies": {
    "@idlizer/arkgen": "2.1.10+devel",
    "@idlizer/etsgen": "2.1.10+devel",
    "@idlizer/core": "2.1.10+devel",
    "@idlizer/libohos": "2.1.10+devel",
    "typescript": "^4.9.5",
    "@types/node": "^18.0.0",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/chai": "^4.3.1",
    "source-map-support": "^0.5.21",
    "rimraf": "^6.0.1"
  },
  "scripts": {
    "clean": "rimraf .rollup.cache lib out",
    "compile:self": "rollup -c",
    "compile": "npm run compile -C ../etsgen && npm run compile -C ../arkgen && npm run compile:self",
    "prepare:sdk": "rimraf ../sdk-patched-arkts ../sdk-patched ../absolute-sdk-patched-arkts && npm run compile && node . sdk ../interface_sdk-js ../sdk-patched-arkts ../sdk-patched",
    "absolute:sdk": "rimraf ../absolute-sdk-patched-arkts && npm run compile && node . m3-sdk ../sdk-patched-arkts ../absolute-sdk-patched-arkts",
    "tracker": "npm run compile && node . tracker ../sdk-patched-arkts ../interfaces/interfaces/arkui-extra --sdk-status /dev/null --tracker-status /dev/null --output ../doc --options-file ../arkgen/generation-config/config.json",
    "compile:parallel": "npm run compile -C core",
    "generate:140": "node . m3 ../sdk-patched-arkts/ ../interfaces/interfaces/arkui-extra/ --sdk-stage prepared --arkgen-options-file ../arkgen/generation-config/config.json"
  }
}