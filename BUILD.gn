import("./gn/import/idlize_root.gni")
import("./gn/import/npm.gni")
import("./gn/import/node.gni")

if (current_toolchain == host_toolchain) {
    if (idlize_ws == "idlize") {
        npm_install("npm_install_all") {
            deps = [
                "external:npm_install_all"
            ]
            outputs = [
                "$target_out_dir/npm_install_all"
            ]
            project_path = rebase_path(".")
        }
    } else if (idlize_ws == "ohos") {
        group("npm_install_all") {
            # npm install is being executed during prebuilds phase
        }
    } else {
        assert(false, "can not process idlize workspace ${idlize_ws}")
    }
}

group("all") {
    deps = [
        "arkgen:all",
        "ohosgen:all",
        "runner:all",
        "core:all",
        "libohos:all",
        "dtsgen:all",
        "etsgen:all",
        "idlinter:all",
        "tools:all",
    ]
}

# proxy dependency for external_deps in ohos buildsystem
group("runner_compile") {
    deps = [
        "runner:compile"
    ]
}