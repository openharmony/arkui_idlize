{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "module": "CommonJS",
        "rootDir": "../",
        "baseUrl": "../src",
        "outDir": "../build/tests",
        "types": ["node", "mocha"],
        "paths": {
            "@/*": ["*"],
            "@/core/*": ["core/*"],
            "@/analyzers/*": ["analyzers/*"],
            "@/formatters/*": ["formatters/*"],
            "@/cli/*": ["cli/*"],
            "@/types/*": ["types/*"],
            "@/utils/*": ["utils/*"],
            "@/reporting/*": ["reporting/*"]
        }
    },
    "include": [
        "../src/**/*.ts",
        "../libs/**/*.ts",
        "../tests/**/*.ts"
    ]
}

