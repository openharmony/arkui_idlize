{
  "name": "codecheck-fixer",
  "version": "0.10.0",
  "description": "A library for static analysis and automated formatting of TypeScript and C++ code. Ensures CI compliance by providing an API for application integration and a CLI for standalone use.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "codecheck-fixer": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "compile": "npm run build",
    "compile:self": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/src/cli/index.js",
    "test": "harness",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "typescript",
    "cpp",
    "static-analysis",
    "code-formatting",
    "ci-compliance",
    "linting"
  ],
  "author": "CodeCheck Fixer Team",
  "license": "Apache 2.0",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "glob": "^10.3.10",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@koalaui/harness": "panda-next",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2"
  }
}
