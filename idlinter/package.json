{
    "name": "@idlizer/idlinter",
    "version": "2.2.2+devel",
    "description": "Tool for .idl validation",
    "type": "module",
    "main": "build/lib/src/cli.js",
    "bin": "build/lib/src/cli.js",
    "exports": {
        ".": {
            "default": "./build/lib/src/index.js",
            "types": "./build/lib/src/index.d.ts"
