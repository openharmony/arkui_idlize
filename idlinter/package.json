    "license": "Apache-2.0",
    "keywords": [],
    "dependencies": {
        "@idlizer/core": "2.2.2+devel",
        "commander": "^10.0.0"
    },
    "devDependencies": {
        "@types/node": "^18.19.127",
        "typescript": "^4.9.5",
        "tslib": "^2.8.1",
        "@idlizer/rimraf": "2.2.2+devel"
    },
    "scripts": {
        "clean": "rimraf dist build",
