        "@idlizer/rimraf": "2.2.2+devel"
    },
    "scripts": {
        "test": "tsc -p tsconfig.test.json && harness",
        "clean": "rimraf -g build",
        "compile:self": "tsc -b .",
        "compile": "npm run compile:self"
    }
