{
  "name": "@idlizer/arkgen-unit-test",
  "version": "2.1.11+devel",
  "description": "Arkgen unit test",
  "files": [
  ],
  "license": "Apache-2.0",
  "keywords": [],
  "dependencies": {
  },
  "devDependencies": {
  },
  "scripts": {
    "gen": "node ../../ --api-version 99 --idl2peer --reference-names  ./conf/ets-sdk.refs.json --use-memo-m3 --arkts-extension .ets --input-files $(find ./idl -type f | tr '\\n' ' ')  --output-dir ./generated --language $LANG --ignore-default-config --options-file ./conf/config-arkui.json",
    "UNIT": "#-------------------",
    "init:arkts": "./scripts/init-arkts.sh",
    "gen:arkts": "LANG=arkts npm run gen",
    "build:arkts": "fast-arktsc --config ./arktsconfig.json --link-name ./generated/abc/all.abc --compiler ../../../external/incremental/tools/panda/arkts/ui2abc --simultaneous && ninja -C ./generated/abc -f build.ninja",
    "build:arkts:native":  "cd ./../../native && meson setup -Dsource_set=unit-arkts build-unit-arkts && meson compile --verbose -C build-unit-arkts && meson install -C build-unit-arkts",
    "exec:arkts": "ACE_LIBRARY_PATH=./../../native/build-unit-arkts LD_LIBRARY_PATH=./../../native bash ../../../external/incremental/tools/panda/arkts/ark --ark-entry-point arkui.framework.main.ETSGLOBAL::main --ark-boot-files ../../../external/interop/build/interop.abc:../../../external/incremental/runtime/build/incremental.abc:./generated/abc/all.abc generated/abc/all.abc --driver-log info",
    "all:arkts": "npm run -C ../../ compile && npm run init:arkts && npm run gen:arkts && npm run build:arkts && npm run build:arkts:native && npm run exec:arkts",
    "KOTLIN": "#-------------------------",
    "init:kt": "./scripts/init-kotlin.sh",
    "build:kt:interop": "npm run compile:kotlin:interop -C ../../../external/interop",
    "gen:kt": "LANG=kotlin npm run gen",
    "build:kt": "bash ./scripts/compile-kotlin.sh",
    "build:kt:native": "cd ./../../native && meson setup -Dsource_set=unit-kotlin build-unit-kotlin && meson compile --verbose -C build-unit-kotlin && meson install -C build-unit-kotlin",
    "exec:kt": "LD_LIBRARY_PATH=./../../native ACE_LIBRARY_PATH=./../../native ./generated/bin/idlize_test.kexe",
    "all:kt": "npm run -C ../../ compile && npm run init:kt && npm run gen:kt && npm run build:kt:interop && npm run build:kt:native && npm run build:kt && npm run exec:kt"
  }
}
