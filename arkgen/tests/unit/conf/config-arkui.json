{
    "TypePrefix": "Ark_",
    "LibraryPrefix": "",
    "OptionalPrefix": "Opt_",
    "GenerateUnused": false,
    "ApiKind": 10,
    "ApiVersion": 9999,
    "dumpSerialized": false,
    "cppPrefix": "GENERATED_",

    "moduleName": "arkui",
    "modules": {
        "external": {
            "name": "external",
            "packages": ["external"]
        },
        "arkui": {
            "name": "arkui",
            "packages": [
                "arkui",
                "synthetic_types"
            ]
        },
        "unit": {
            "name": "unit",
            "packages": [
                "unit"
            ]
        }
    },
    "libraryNameMapping": {
        "external": {
            "TS": "external",
            "ArkTS": "external"
        }
    },
    "rootComponents": [
        "Root",
        "ComponentRoot",
        "CommonMethod"
    ],
    "ignoreGenerics": [
    ],
    "parameterized": [
    ],
    "components": {
        "handWritten": [
            "AttributeModifier",
            "AttributeUpdater",
            "ModifierState"
        ]
    },
    "forceMaterialized": [
        "arkui.component.common.BaseEvent",
        "arkui.component.common.ClickEvent"
    ],
    "forceCallback": {
       "DrawModifier": [
            "drawBehind",
            "drawContent",
            "drawFront"
        ]
    },
    "hooks": {
        "CheckHooksAttribute": {
            "text": {
                "hookName": "hookCheckHooksText",
                "replaceImplementation": true
            },
            "methodPrimitives": {
                "hookName": "hookCheckHooksMethodPrimitives",
                "replaceImplementation": true
            }
        }
    },
    "transformOnSerialize": [
        {
            "from": "arkui.component.check.transform.SampleTransformSrcI",
            "to": "arkui.component.check.transform.SampleTransformDstI"
        },
        {
            "from": "arkui.component.check.transform.TransformSrcCallbackI",
            "to": "arkui.component.check.transform.TransformDstCallbackI"
        }
    ],
    "dummy": {
        "ignoreMethods": {
            "RenderServiceNode": [
                "getNodeId"
            ],
            "ScreenshotService": [
                "requestScreenshot"
            ],
            "EventEmulator": [
                "emitClickEvent"
            ]
        }
    },
    "currentModulePackagesPaths": [
        {
            "package": "arkui",
            "path": "./"
        }
    ]
}
