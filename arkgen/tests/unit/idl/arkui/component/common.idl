package arkui.component.common;
import arkui.component.units.Length as Length;
import arkui.Graphics.DrawContext as _DrawContext;
typedef DrawContext = _DrawContext;

// TBD: used in conf/ets-sdk.refs.json
interface <T> AttributeModifier {
    void applyNormalAttribute(T instance);
};

interface BaseEvent {
    attribute number timestamp;
};

// TBD: required for CallDrawModifierCallbacks in dummy_impl.cpp
[Synthetic]
callback Callback_Void = void ();
interface ClickEvent: BaseEvent {
    attribute number x;
    attribute number y;
};

interface AnimateParam {
    [Optional]
    attribute number duration;
};
// TBD: required for CallDrawModifierCallbacks in dummy_impl.cpp
[Synthetic]
callback Callback_DrawContext_Void = void (DrawContext drawContext);
[Entity=Class]
interface DrawModifier {
    constructor();
    [ExtraMethod=drawBehind, Accessor=Getter]
    attribute Callback_DrawContext_Void drawBehind_callback;
    [ExtraMethod=drawBehind, Accessor=Setter]
    attribute Callback_DrawContext_Void drawBehind_callback;
};