package arkui.component.check.enum;

import external.ExternalEnumString as ExternalEnumString;
import internal.InternalEnumString as InternalEnumString;

enum EnumUByte {
    number E0 = 0;
    number E1 = 1;
    number E255 = 255;
};

enum EnumByte {
    number E0 = 0;
    number EN127 = -127;
    number E127 = 127;
};

enum EnumInt {
    number E0 = 0;
    number E512 = 512;
};

enum EnumLong {
    number E0 = 0;
    number EFFFFFFFFA = 0xFFFFFFFFA;
};

enum EnumString {
    [OriginalEnumMemberName=e1]
    String E1 = "e11";
    [OriginalEnumMemberName=e2]
    String E2 = "e22";
    String E_MIDDLE = "eMiddle";
    [OriginalEnumMemberName=e3]
    String E3 = "e33";
};

[Component]
interface CheckEnumAttribute: Root {
    attribute EnumUByte enumUByte;
    attribute EnumByte enumByte;
    attribute EnumInt enumInt;
    attribute EnumLong enumLong;
    attribute EnumString enumString;
    attribute InternalEnumString internalEnumString;
    attribute ExternalEnumString externalEnumString;
};
