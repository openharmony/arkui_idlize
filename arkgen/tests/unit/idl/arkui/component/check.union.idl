package arkui.component.check.union;
import arkui.component.builder.CustomBuilder as CustomBuilder;

interface SwipeActionItem {
    optional attribute CustomBuilder builder;
};

[Entity=Tuple]
interface DoubleLengthTuple {
    attribute SwipeActionItem value0;
    attribute CustomBuilder value1;
};

interface SwipeActionOptions {
    optional attribute (CustomBuilder or SwipeActionItem) start;
    optional attribute (CustomBuilder or SwipeActionItem) end;
    optional attribute (CustomBuilder or SwipeActionItem or DoubleLengthTuple) smth;
};

[Component]
interface ListItemAttribute: Root {
    attribute (SwipeActionOptions or undefined) swipeAction;
};
