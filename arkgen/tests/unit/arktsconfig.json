{
    "compilerOptions": {
        "package": "arkui",
        "baseUrl": "generated/sig/arkoala-arkts/arkui/generated",
        "outDir": "generated/abc",
        "paths": {
            "#components": [
                "./framework/arkts"
            ],
            "#handwritten": [
                "./handwritten"
            ],
            "#arktheme": [
                "./ArkThemeScopeManager"
            ],
            "internal": [
                "../../../../../generated/modules/internal/generated/arkts"
            ],
            "external": [
                "../../../../../generated/modules/external/generated/arkts"
            ],
            "@koalaui/builderLambda": [
                "./annotations"
            ],
            "arkui.PeerNode": [
                "./PeerNode"
            ],
            "@koalaui/common": [
                "../../../../../../../../node_modules/@koalaui/common/src"
            ],
            "@koalaui/interop": [
                "../../../../../../../../node_modules/@koalaui/interop/src/arkts"
            ],
            "@koalaui/compat": [
                "../../../../../../../../node_modules/@koalaui/compat/src/arkts"
            ]
        }
    },
    "include": [
        "generated/sig/arkoala-arkts/arkui/generated/**/*.ets"
    ],
    "exclude": [
        "generated/sig/arkoala-arkts/arkui/src/sdk/**/*"
    ]
}
