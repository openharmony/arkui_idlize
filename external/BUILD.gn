import("../gn/import/npm.gni")
import("../gn/import/node.gni")


node_cmd("download:sdk") {
    script = rebase_path("./download-sdk.mjs")
    inputs = [ rebase_path("./download-sdk.json") ]
}

node_cmd("prepare:sdk") {
    script = rebase_path("../runner")
    args = [
        "sdk",
        rebase_path("./interface_sdk-js"),
        rebase_path("../sdk-patched-arkts"),
        rebase_path("../sdk-patched"),
    ]
    deps = [
        "../runner:compile",
        ":download:sdk",
    ]
}

group("sdk") {
    deps = [
        ":download:sdk",
        ":prepare:sdk"
    ]
}

group("all") {
    deps = [
        ":download:sdk",
        ":prepare:sdk",
    ]
}
