import("../gn/import/npm.gni")
import("../gn/import/node.gni")

npm_cmd("compile") {
    deps = [
        "../core:compile"
    ]
    project_path = rebase_path(".")
    run_tasks = [ "compile:self" ]
}

node_cmd("etsgen:generate") {
    script = rebase_path("../etsgen")
    args = [
        "--ets2idl",
        "--output-dir",
        rebase_path("$root_gen_dir/interfaces/idl"),
        "--base-dir",
        rebase_path("../sdk-patched-arkts/api"),
        "--input-dir",
        rebase_path("../sdk-patched-arkts/api"),
    ]
    deps = [
        "../etsgen:compile",
        "../tools:sdk"
    ]
}

node_cmd("test") {
    deps = [
        ":compile",
        ":etsgen:generate",
    ]
    script = rebase_path("../idlinter")
    args = [
        "check",
        rebase_path("./interfaces"),
        "--load",
        rebase_path("$root_gen_dir/interfaces/idl"),
        rebase_path("../libohos/predefined/stdlib.idl"),
    ]
}

group("all") {
    deps = [
        ":compile",
        ":etsgen:generate",
        ":test",
    ]
}
