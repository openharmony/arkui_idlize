package arkui.component.idlize;

import arkui.component.common;

[Entity=Class]
interface EventEmulator {
  static void emitClickEvent(pointer node, ClickEvent event);
  static void emitTextInputEvent(pointer node, String text);
};

[Entity=Class]
interface RenderServiceNode {
  static i32 getNodeId(String nodeId);
};

[Entity=Class]
interface ScreenshotService {
  static void provideSettings(String goldenPath, String outputPath, boolean generateGoldenFiles, f64 similarityThreshold);
  static boolean makeScreenshot(pointer data, i64 length, i32 width, i32 height, i64 timeStamp);
  static boolean compare(String test, String expected, i64 requestID);
  static void requestFrame(i64 requestID);
};
