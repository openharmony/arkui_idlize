{
    "name": "@idlizer/ohosgen",
    "version": "2.2.2+devel",
    "description": "",
    "type": "module",
    "main": "build/lib/src/main.js",
    "bin": "build/lib/src/main.js",
    "types": "./build/lib/src/index.d.ts",
    "exports": {
        ".": [
            "./build/lib/src/index.js"
        ]
    },
    "files": [
        "build/**/*.ts",
        "build/**/*.js",
        "build/**/*.map",
        "lib/*.js",
        "lib/*.map",
        "stdlib.d.ts",
        "whitelist.json",
        "generation-config/**/*"
    ],
    "license": "Apache-2.0",
    "keywords": [],
    "dependencies": {
        "@idlizer/kit": "2.2.2+devel",
        "@idlizer/ost": "2.2.2+devel",
        "@idlizer/core": "2.2.2+devel",
        "@idlizer/libohos": "2.2.2+devel",
        "@types/node": "^18.19.127",
        "commander": "^10.0.0",
        "typescript": "^4.9.5"
    },
    "devDependencies": {
        "@types/node": "^18.19.127",
        "@koalaui/interop": "panda-next",
        "@idlizer/rimraf": "2.2.2+devel"
    },
    "scripts": {
        "clean": "rimraf lib",
        "compile:self": "tsc -b .",
        "compile": "npm run --prefix ../dtsgen compile && npm run --prefix ../libohos compile && npm run compile:self",
        "compile:all": "npm run compile && npm run compile -C ../etsgen",
        "run:xml:ts": "npm run compile:all && node . --idl2peer --input-dir ./demos/xml/idl --output-dir ./demos/xml --options-file ./demos/xml/conf/config.json",
        "run:xml:arkts": "npm run compile:all && node . --idl2peer --input-dir ./demos/xml/idl --output-dir ./demos/xml --language=arkts --options-file ./demos/xml/conf/config.json",
        "run:xml:cj": "npm run compile:all && node . --idl2peer --input-dir ./demos/xml/idl --output-dir ./demos/xml --language=cangjie --options-file ./demos/xml/conf/config.json",
        "run:xml:kt": "npm run compile:all && node . --idl2peer --input-dir ./demos/xml/idl --output-dir ./demos/xml --language=kotlin --options-file ./demos/xml/conf/config.json",
        "generate:mediaquery:idl": "npm run compile && node ../dtsgen --dts2idl --base-dir ./demos/mediaquery/dts/api --input-files ./demos/mediaquery/dts/api/@ohos.mediaquery.d.ts --output-dir ./demos/mediaquery/generated/idl",
        "run:mediaquery:ts": "npm run generate:mediaquery:idl && node . --idl2peer --language=ts --input-dir ./demos/mediaquery/generated/idl --output-dir ./demos/mediaquery --options-file ./demos/mediaquery/config.json",
        "run:mediaquery:arkts": "npm run generate:mediaquery:idl && node . --idl2peer --language=arkts --input-dir ./demos/mediaquery/generated/idl --output-dir ./demos/mediaquery --options-file ./demos/mediaquery/config.json",
        "run:mediaquery:cj": "npm run generate:mediaquery:idl && node . --idl2peer --language=cangjie --input-dir ./demos/mediaquery/generated/idl --output-dir ./demos/mediaquery --options-file ./demos/mediaquery/config.json",
        "generate:context:idl": "npm run compile && node ../dtsgen --dts2idl --base-dir ./demos/context/dts/api --input-dir ./demos/context/dts/api/application,./demos/context/dts/api/bundleManager --output-dir ./demos/context/generated/idl",
        "run:context:arkts:MODULE": "node . --idl2peer --language=arkts --input-dir ./demos/context/generated/idl --output-dir ./demos/context/$MODULE --options-file ./demos/context/config.json ./demos/context/$MODULE/config.json",
        "run:context:arkts": "npm run generate:context:idl && MODULE=application npm run run:context:arkts:MODULE && MODULE=bundleManager npm run run:context:arkts:MODULE",
        "run:huks:ts": "node . --idl2peer --language=ts --input-files ./demos/huks/idl/@ohos.security.huks.idl --output-dir ./demos/huks --options-file ./demos/huks/config.json",
        "run:huks:arkts": "node . --idl2peer --language=arkts --input-files ./demos/huks/idl/@ohos.security.huks.idl --output-dir ./demos/huks --options-file ./demos/huks/config.json",
        "run:unit:ts": "npm run compile && node . --idl2peer --language=ts --default-idl-package unit --input-dir ./tests/unit/idl --output-dir ./tests/unit",
        "run:unit:arkts": "npm run compile && node . --idl2peer --language=arkts --default-idl-package unit --input-dir ./tests/unit/idl --output-dir ./tests/unit",
        "run:unit:kt": "npm run compile && node . --idl2peer --language=kotlin --default-idl-package unit --input-dir ./tests/unit/idl --output-dir ./tests/unit",
        "generate:dummy:idl": "npm run compile && node ../dtsgen --dts2idl --input-dir ./tests/dummy/dts --output-dir ./tests/dummy/generated/idl --options-file ./tests/dummy/conf/config.json",
        "run:dummy:ts": "npm run generate:dummy:idl && node . --idl2peer --language=ts --default-idl-package dummy --input-dir ./tests/dummy/generated/idl,./tests/dummy/idl --output-dir ./tests/dummy",
        "run:dummy:arkts": "npm run generate:dummy:idl && node . --idl2peer --language=arkts --default-idl-package dummy --input-dir ./tests/dummy/generated/idl,./tests/dummy/idl --output-dir ./tests/dummy",
        "generate:image:arkts": "MODULE_LANG=arkts MODULE_NAME=image MODULE_OUT=./out/modules-arkts npm run generate:module",
        "generate:image:ts": "MODULE_LANG=ts MODULE_NAME=image MODULE_OUT=./out/modules-ts npm run generate:module",
        "generate:global:arkts": "MODULE_LANG=arkts MODULE_NAME=global MODULE_OUT=./out/modules-arkts npm run generate:module",
        "generate:global:ts": "MODULE_LANG=ts MODULE_NAME=global MODULE_OUT=./out/modules-ts npm run generate:module",
        "generate:modules-all:ts": "MODULE_LANG=ts MODULE_OUT=./out/modules-ts npm run generate:modules-all",
        "generate:modules-all:arkts": "MODULE_LANG=arkts MODULE_OUT=./out/modules-arkts npm run generate:modules-all",
        "generate:modules-all": "MODULE_NAME=global npm run generate:module && MODULE_NAME=image npm run generate:module",
        "generate:modules-sdk": "MODULE_NAME=global npm run generate:module",
        "generate:module": "node . --idl2peer --input-files $(find ../etsgen/out/idl -type f | tr '\\n' ' ') --implicit-predefined --language=${MODULE_LANG} --output-dir ${MODULE_OUT}/${MODULE_NAME} --options-file ../arkgen/generation-config/config.json ../arkgen/generation-config/config-arkui.json ./generation-config/config-${MODULE_NAME}.json",
        "generate-schema": "npm run compile && node . --show-config-schema > generation-config/schema.json",
        "generate:skoala:idl": "npm run compile && node ../dtsgen --dts2idl --output-dir ./tests/skoala/generated/idl --input-dir ./tests/skoala/dts/ --base-dir ./tests/skoala/dts/ --options-file ./generation-config/skoala-config.json",
        "run:skoala:ts": "npm run generate:skoala:idl && node . --idl2peer --input-dir ./tests/skoala/generated/idl --output-dir ./tests/skoala/generated/skoala_ohos --language=ts --options-file ./generation-config/skoala-config.json"
    }
}
