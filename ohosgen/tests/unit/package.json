{
    "name": "unit-tests",
    "private": true,
    "dependencies": {
        "@koalaui/compat": "1.5.0-dev.78036-9868",
        "@koalaui/common": "1.5.0-dev.78036-9868",
        "@koalaui/interop": "1.5.0-dev.78036-9868",
        "commander": "^10.0.0"
    },
    "devDependencies": {
        "@koalaui/smart-arkts": "1.5.0-dev.78036-9868",
        "esbuild": "^0.27.3"
    },
    "scripts": {
        "clean:ts": "rm -rf generated/ts",
        "clean:arkts": "rm -rf generated/arkts",
        "clean:cj": "rm -rf generated/cj",
        "clean:kt": "rm -rf generated/kotlin",
        "clean:native": "rm -rf generated/native",
        "gen": "npm run run:unit:${TARGET} -C ../.. -- --output-dir tests/unit --options-file tests/unit/conf/config.json",
        "gen:ts": "TARGET=ts npm run gen",
        "gen:arkts": "TARGET=arkts npm run gen",
        "gen:cj": "TARGET=cj npm run gen",
        "gen:kt": "TARGET=kt npm run gen",
        "compile:ts": "esbuild src/node/main.ts --bundle --outfile=build/node/index.js --platform=node --target=es2017 --format=cjs --external:@koalaui/*",
        "compile:arkts": "bash scripts/build-panda.sh",
        "compile:cj": "",
        "compile:kt": "bash scripts/build-kotlin.sh",
        "compile:interop:native:kt": "npm run compile:native-kotlin-host --prefix ../../../external/koala_projects/interop && npm run compile:kotlin:interop --prefix ../../../external/koala_projects/interop",
        "compile:native": "meson setup build/native/${TARGET_VM} -Dtarget_vm=${TARGET_VM} && meson compile -C build/native/${TARGET_VM} && meson install -C build/native/${TARGET_VM}",
        "compile:native:ts": "TARGET_VM=node npm run compile:native",
        "compile:native:arkts": "TARGET_VM=panda npm run compile:native",
        "compile:native:cj": "TARGET_VM=cangjie npm run compile:native",
        "compile:native:kt": "npm run compile:interop:native:kt && TARGET_VM=kotlin npm run compile:native",
        "exec:ts": "bash scripts/run-ts.sh",
        "exec:arkts": "bash scripts/run-panda.sh",
        "exec:cj": "bash scripts/run-cj.sh",
        "exec:kt": "bash scripts/run-kt.sh",
        "build": "npm run compile:native:${TARGET} && npm run compile:${TARGET}",
        "build:ts": "TARGET=ts npm run build",
        "build:arkts": "TARGET=arkts npm run build",
        "build:cj": "TARGET=cj npm run build",
        "build:kt": "TARGET=kt npm run build",
        "all": "npm run clean:native && npm run clean:${TARGET} && npm run gen:${TARGET} && npm run build:${TARGET} && npm run exec:${TARGET}",
        "all:ts": "TARGET=ts npm run all",
        "all:arkts": "TARGET=arkts npm run all",
        "all:cj": "TARGET=cj npm run all",
        "all:kt": "npm run download:koala_projects -C ../../../external && TARGET=kt npm run all"
    }
}
