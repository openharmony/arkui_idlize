package test_exception;
[Entity=Class]
interface CheckExceptionInterface {
    constructor();
    [Throws]
    void checkException();
};
[Entity=Class]
interface CheckExceptionClass {
    constructor();
    [Throws]
    void checkException();
    [Throws]
    CheckExceptionInterface getInterface();
    [Throws]
    async CheckExceptionInterface getPromiseInterface();
    [Throws]
    sequence<i32> getArray();
    [Throws]
    this getThis();
};