{
    "$schema": "../../../generation-config/schema.json",
    "moduleName": "unit",
    "modules": {
        "ohos.base": {
            "name": "ohos.base",
            "packages": ["ohos.base"]
        },
        "external.lib": {
            "name": "external.lib",
            "external": true,
            "packages": [
                "external.lib"
            ]
        },
        "renamed.lib": {
            "name": "renamed.lib",
            "packages": [
                "renamed.lib"
            ]
        },
        "internal_lib": {
            "name": "internal_lib",
            "packages": [
                "internal.lib"
            ]
        },
        "unit": {
            "name": "unit",
            "packages": [
                "synthetic_types",
                "test_any",
                "test_bigint",
                "test_boolean",
                "test_buffer",
                "test_class_props_initial_values",
                "test_const",
                "test_constants",
                "test_constructor",
                "test_cyclic",
                "test_data_class",
                "test_declare_type",
                "test_duplicates",
                "test_enum",
                "test_enums",
                "test_exception",
                "test_external_types",
                "test_force_callback",
                "test_force_context",
                "test_generic_interface",
                "test_generics",
                "test_handwritten",
                "test_hierarchy",
                "test_hilog",
                "test_hooks",
                "test_idl_constants",
                "test_inheritance",
                "test_internal_lib",
                "test_length",
                "test_materialized_classes",
                "test_materialized_interfaces",
                "test_multiple_instances",
                "test_non_static",
                "test_number",
                "test_optional",
                "test_override_methods",
                "test_promise",
                "test_props",
                "test_return_buffer",
                "test_return_types",
                "test_sequences",
                "test_synthetics",
                "test_transform",
                "test_union",
                "test_wrapped_builder",

                "idlize.internal"
            ],
            "useFoldersLayout": true
        }
    },
    "libraryNameMapping": {
        "renamed.lib": {
            "TS": "@newname.lib",
            "ArkTS": "@newname.lib"
        }
    },
    "TypePrefix": "OH_",
    "LibraryPrefix": "",
    "OptionalPrefix": "Opt_",
    "GenerateUnused": false,
    "dumpSerialized": false,
    "ignoreMaterialized": [
        "DataClass",
        "ClassWithPrimitivePropertyType",
        "ClassWithComplexPropertyType",
        "TransformSrcC",
        "TransformDstC"
    ],
    "forceMaterialized": [
        "application.BaseContext.BaseContext",
        "test_exception.CheckExceptionInterface",
        "test_generic_interface.GenericInterface",
        "test_materialized_classes.test_materialized_classes.MaterializedWithCreateMethod",
        "test_hooks.HookInterface"
    ],
    "forceResource": [
       "ContentModifier",
       "test_cyclic.CyclicTypedefForceResource"
    ],
    "forceContext": [
        "test_force_context.ForceContext.method_",
        "test_force_context.ForceContext.static_method",
        "test_force_context.NS.ForceContextNS.method_",
        "test_force_context.NS.ForceContextNS.static_method",
        "test_exception.CheckCallbackExceptions.checkThrowableCallbackI32",
        "test_exception.CheckCallbackExceptions.checkThrowableCallbackI32_withParameter",
        "test_exception.CheckCallbackExceptions.checkThrowableCallbackVoid",
        "test_exception.CheckCallbackExceptions.ThrowableCallbackSequence",
        "test_exception.CheckCallbackExceptions.checkRethrow"
    ],
    "rootComponents": [],
    "parameterized": [],
    "builderClasses": [],
    "components": {
        "custom": [],
        "customNodeTypes": [],
        "handWritten": [
            "HandwrittenComponent",
            "IdlHandwrittenComponent",
            "TransformSrcCallbackC"
        ],
        "ignoreEntry": [],
        "ignoreComponents": [],
        "ignorePeerMethod": [],
        "invalidAttributes": [],
        "replaceThrowErrorReturn": []
    },
    "hooks": {
        "HookInterface": {
            "method": {
                "hookName": "customHookInterfaceMethod",
                "replaceImplementation": true
            },
            "methodArg": {
                "hookName": "customHookInterfaceMethodArg",
                "replaceImplementation": true
            },
            "methodReturn": {
                "hookName": "hookHookInterfaceMethodReturn",
                "replaceImplementation": true
            },
            "methodImportedArg": {
                "hookName": "hookHookInterfaceImportedArg",
                "replaceImplementation": true
            },
            "methodImportedReturn": {
                "hookName": "customHookInterfaceMethodImportedReturn",
                "replaceImplementation": true
            }
        },
        "HookClass": {
            "method": {
                "hookName": "customHookClassMethod",
                "replaceImplementation": true
            },
            "methodArg": {
                "hookName": "customHookClassMethodArg",
                "replaceImplementation": true
            },
            "methodReturn": {
                "hookName": "hookHookClassMethodReturn",
                "replaceImplementation": true
            },
            "methodImportedArg": {
                "hookName": "hookHookClassImportedArg",
                "replaceImplementation": true
            },
            "methodImportedReturn": {
                "hookName": "customHookClassMethodImportedReturn",
                "replaceImplementation": true
            }
        }
    },
    "transformOnSerialize": [
        {
            "from": "test_transform.TransformSrcI",
            "to": "test_transform.TransformDstI"
        },
        {
            "from": "test_transform.TransformSrcC",
            "to": "test_transform.TransformDstC"
        },
        {
            "from": "test_transform.TransformSrcCallbackI",
            "to": "test_transform.TransformDstCallbackI"
        },
        {
            "from": "test_transform.TransformSrcCallbackC",
            "to": "test_transform.TransformDstCallbackC"
        },
        {
            "from": "test_transform.TransformMeToWithOptional",
            "to": "test_transform.WithOptional"
        }
    ],
    "materialized": {
        "ignoreReturnTypes": []
    },
    "cppPrefix": "GENERATED_",
    "serializer": {
        "ignore": []
    },
    "dummy": {
        "ignoreMethods": {}
    },
    "handwrittenDeserializers": [
        "test_inheritance.BaseGesture"
    ]
}
