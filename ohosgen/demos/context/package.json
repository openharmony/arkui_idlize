{
    "name": "demo-context",
    "private": true,
    "devDependencies": {
        "@koalaui/smart-arkts": "panda-next",
        "@rollup/plugin-inject": "^5.0.5",
        "@rollup/plugin-node-resolve": "^15.3.0",
        "@rollup/plugin-typescript": "^11.1.6",
        "rollup": "^4.24.4"
    },
    "scripts": {
        "clean:ts": "rm -rf application/generated/ts bundleManager/generated/ts",
        "clean:arkts": "rm -rf application/generated/arkts bundleManager/generated/arkts",
        "clean:cj": "rm -rf application/generated/cj bundleManager/generated/cj",
        "clean:native": "rm -rf application/generated/native bundleManager/generated/native",

        "gen": "npm run run:context:${TARGET} -C ../..",
        "gen:ts": "TARGET=ts npm run gen",
        "gen:arkts": "TARGET=arkts npm run gen",
        "gen:cj": "TARGET=cj npm run gen",

        "compile:ts": "rollup -c",
        "compile:arkts": "bash scripts/build-panda.sh",
        "compile:cj": "",

        "compile:native": "meson setup build/native/${TARGET_VM} -Dtarget_vm=${TARGET_VM} && meson compile -C build/native/${TARGET_VM} && meson install -C build/native/${TARGET_VM}",
        "compile:native:ts": "TARGET_VM=node npm run compile:native",
        "compile:native:arkts": "TARGET_VM=panda npm run compile:native",
        "compile:native:cj": "TARGET_VM=cangjie npm run compile:native",

        "exec:ts": "bash scripts/run-ts.sh",
        "exec:arkts": "bash scripts/run-panda.sh",
        "exec:cj": "bash scripts/run-cj.sh",

        "build": "npm run compile:${TARGET} && npm run compile:native:${TARGET}",
        "build:ts": "TARGET=ts npm run build",
        "build:arkts": "TARGET=arkts npm run build",
        "build:cj": "TARGET=cj npm run build",

        "all": "npm run clean:native && npm run clean:${TARGET} && npm run gen:${TARGET} && npm run build:${TARGET} && npm run exec:${TARGET}",
        "all:ts": "TARGET=ts npm run all",
        "all:arkts": "TARGET=arkts npm run all",
        "all:cj": "TARGET=cj npm run all"
    },
    "dependencies": {
        "@koalaui/compat": "panda-next",
        "@koalaui/common": "panda-next",
        "@koalaui/interop": "panda-next"
    }
}
