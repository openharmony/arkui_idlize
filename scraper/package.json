{
  "name": "@idlizer/scraper",
  "version": "2.2.2+devel",
  "type": "module",
  "main": "build/lib/src/main.js",
  "bin": "build/lib/src/main.js",
  "typesVersions": {
    "*": {
      "app": [
        "build/lib/src/app.d.ts"
      ]
    }
  },
  "types": "./build/lib/src/index.d.ts",
  "exports": {
    "./app": [
      "./build/lib/src/library.js"
    ]
  },
  "scripts": {
    "compile:self": "tsc -b .",
    "compile": "npm run -C ../core compile && npm run compile:self",
    "chmod": "chmod +x ./out/go-main.sh",
    "go": "npm run compile && node . ../etsgen/out/idl && npm run chmod",
    "build": "cd out && fast-arktsc --config ./ui2abcconfig.json --simultaneous --link-name ./build/abc/all.abc && ninja -C ./generated/abc -f build.ninja",
    "generate": "./out/go-main.sh",
    "clean:generate": "rimraf out/generated && npm run generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@idlizer/core": "2.2.2+devel",
    "commander": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.127",
    "typescript": "^4.9.5",
    "@idlizer/rimraf": "2.2.2+devel"
  }
}