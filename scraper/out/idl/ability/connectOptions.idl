package ability.connectOptions;
import bundleManager.ElementName.ElementName as ElementName;
import ohos.rpc.default as rpc;
callback OnConnectFn = void (ElementName elementName, rpc.IRemoteObject remote);
callback OnDisconnectFn = void (ElementName elementName);
callback OnFailedFn = void (i32 code);
interface ConnectOptions {
    attribute OnConnectFn onConnect;
    attribute OnDisconnectFn onDisconnect;
    attribute OnFailedFn onFailed;
};