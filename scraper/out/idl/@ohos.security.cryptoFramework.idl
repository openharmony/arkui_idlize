package ohos.security.cryptoFramework;
import ohos.base.AsyncCallback as AsyncCallback;
[DefaultExport]
namespace cryptoFramework {
    interface DataBlob {
        attribute buffer data;
    };
    interface Key {
        readonly attribute String format;
        readonly attribute String algName;
        DataBlob getEncoded();
    };
    interface PubKey: Key {
        (bigint or String or i32) getAsyKeySpec(AsyKeySpecItem itemType);
        DataBlob getEncodedDer(String format);
        String getEncodedPem(String format);
    };
    dictionary AsyKeySpecItem {
        number DSA_P_BN = 101;
        number DSA_Q_BN = 102;
        number DSA_G_BN = 103;
        number DSA_SK_BN = 104;
        number DSA_PK_BN = 105;
        number ECC_FP_P_BN = 201;
        number ECC_A_BN = 202;
        number ECC_B_BN = 203;
        number ECC_G_X_BN = 204;
        number ECC_G_Y_BN = 205;
        number ECC_N_BN = 206;
        number ECC_H_NUM = 207;
        number ECC_SK_BN = 208;
        number ECC_PK_X_BN = 209;
        number ECC_PK_Y_BN = 210;
        number ECC_FIELD_TYPE_STR = 211;
        number ECC_FIELD_SIZE_NUM = 212;
        number ECC_CURVE_NAME_STR = 213;
        number RSA_N_BN = 301;
        number RSA_SK_BN = 302;
        number RSA_PK_BN = 303;
        number DH_P_BN = 401;
        number DH_G_BN = 402;
        number DH_L_NUM = 403;
        number DH_SK_BN = 404;
        number DH_PK_BN = 405;
        number ED25519_SK_BN = 501;
        number ED25519_PK_BN = 502;
        number X25519_SK_BN = 601;
        number X25519_PK_BN = 602;
    };
};