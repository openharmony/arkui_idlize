package ohos.graphics.drawing;
import ohos.multimedia.image.default as image;
import ohos.graphics.common2D.default as common2D;
import ohos.graphics.colorSpaceManager.default as colorSpaceManager;
import global.resource.Resource as Resource;
[DefaultExport]
namespace drawing {
    dictionary BlendMode {
        number CLEAR = 0;
        number SRC = 1;
        number DST = 2;
        number SRC_OVER = 3;
        number DST_OVER = 4;
        number SRC_IN = 5;
        number DST_IN = 6;
        number SRC_OUT = 7;
        number DST_OUT = 8;
        number SRC_ATOP = 9;
        number DST_ATOP = 10;
        number XOR = 11;
        number PLUS = 12;
        number MODULATE = 13;
        number SCREEN = 14;
        number OVERLAY = 15;
        number DARKEN = 16;
        number LIGHTEN = 17;
        number COLOR_DODGE = 18;
        number COLOR_BURN = 19;
        number HARD_LIGHT = 20;
        number SOFT_LIGHT = 21;
        number DIFFERENCE = 22;
        number EXCLUSION = 23;
        number MULTIPLY = 24;
        number HUE = 25;
        number SATURATION = 26;
        number COLOR = 27;
        number LUMINOSITY = 28;
    };
    dictionary FilterMode {
        number FILTER_MODE_NEAREST = 0;
        number FILTER_MODE_LINEAR = 1;
    };
    [Entity=Class]
    interface SamplingOptions {
        constructor();
        constructor(FilterMode filterMode);
    };
    [Entity=Class]
    interface Canvas {
        constructor(image.PixelMap pixelmap);
        void drawRect(common2D.Rect rect);
        void drawRect(f64 left, f64 top, f64 right, f64 bottom);
        void drawImageRect(image.PixelMap pixelmap, common2D.Rect dstRect, optional SamplingOptions samplingOptions);
        void drawPixelMapMesh(image.PixelMap pixelmap, i32 meshWidth, i32 meshHeight, sequence<f64> vertices, i32 vertOffset, sequence<i32> colors, i32 colorOffset);
        void attachBrush(Brush brush);
        void detachBrush();
        i64 saveLayer(optional (common2D.Rect or undefined) rect, optional (Brush or undefined) brush);
        void restore();
        void rotate(f64 degrees, f64 sx, f64 sy);
    };
    [Entity=Class]
    interface Lattice {
        constructor();
        static Lattice createImageLattice(sequence<i32> xDivs, sequence<i32> yDivs, i32 fXCount, i32 fYCount, optional (common2D.Rect or undefined) fBounds, optional (sequence<RectType> or undefined) fRectTypes, optional (sequence<common2D.Color> or undefined) fColors);
    };
    dictionary RectType {
        number DEFAULT = 0;
        number TRANSPARENT = 1;
        number FIXEDCOLOR = 2;
    };
    [Entity=Class]
    interface ColorFilter {
        constructor();
        static ColorFilter createBlendModeColorFilter((common2D.Color or i32) color, BlendMode mode);
    };
    [Entity=Class]
    interface Brush {
        constructor();
        constructor(Brush brush);
        void setBlendMode(BlendMode mode);
        void reset();
    };
};