package ohos.app.ability.UIAbility;
import ohos.app.ability.Ability.default as Ability;
import ohos.app.ability.AbilityConstant.default as AbilityConstant;
import ohos.app.ability.Want.default as Want;
import ohos.window.default as window;
import application.UIAbilityContext.default as UIAbilityContext;
import ohos.rpc.default as rpc;
callback OnReleaseCallback = void (String msg);
callback OnRemoteStateChangeCallback = void (String msg);
callback CalleeCallback = rpc.Parcelable (rpc.MessageSequence indata);
interface Caller {
    Promise<void> call(String method, rpc.Parcelable data);
    Promise<rpc.MessageSequence> callWithResult(String method, rpc.Parcelable data);
    void release();
    void onRelease0(OnReleaseCallback callback_);
    void onRemoteStateChange(OnRemoteStateChangeCallback callback_);
    [DtsTag="'release'", DtsName="on"]
    void onRelease1(OnReleaseCallback callback_);
    [DtsTag="'release'", DtsName="off"]
    void offRelease(OnReleaseCallback callback_);
    [DtsTag="'release'", DtsName="off"]
    void offRelease();
};
interface Callee {
    void on(String method, CalleeCallback callback_);
    void off(String method);
};
[Entity=Class, DefaultExport]
interface UIAbility: [Extends] Ability {
    constructor();
    attribute UIAbilityContext context;
    attribute Want launchWant;
    attribute Want lastRequestWant;
    attribute Callee callee;
    void onCreate(Want want, AbilityConstant.LaunchParam launchParam);
    void onWindowStageCreate(window.WindowStage windowStage);
    void onWindowStageWillDestroy(window.WindowStage windowStage);
    void onWindowStageDestroy();
    void onWindowStageRestore(window.WindowStage windowStage);
    void onDestroy();
    Promise<void> onDestroyAsync();
    void onForeground();
    void onWillForeground();
    void onDidForeground();
    void onBackground();
    void onWillBackground();
    void onDidBackground();
    void onNewWant(Want want, AbilityConstant.LaunchParam launchParam);
    sequence<String> onDump(sequence<String> params);
    AbilityConstant.OnSaveResult onSaveState(AbilityConstant.StateType reason, record<String, Object> wantParam);
    Promise<AbilityConstant.OnSaveResult> onSaveStateAsync(AbilityConstant.StateType stateType, record<String, Object> wantParam);
    void onShare(record<String, Object> wantParam);
    boolean onPrepareToTerminate();
    Promise<boolean> onPrepareToTerminateAsync();
    boolean onBackPressed();
};