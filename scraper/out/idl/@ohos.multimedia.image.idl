package ohos.multimedia.image;
import ohos.base.AsyncCallback as AsyncCallback;
import ohos.graphics.colorSpaceManager.default as colorSpaceManager;
import ohos.resourceManager.default as resourceManager;
import ohos.rpc.default as rpc;
[DefaultExport]
namespace image {
    dictionary PixelMapFormat {
        number UNKNOWN = 0;
        number ARGB_8888 = 1;
        number RGB_565 = 2;
        number RGBA_8888 = 3;
        number BGRA_8888 = 4;
        number RGB_888 = 5;
        number ALPHA_8 = 6;
        number RGBA_F16 = 7;
        number NV21 = 8;
        number NV12 = 9;
        number RGBA_1010102 = 10;
        number YCBCR_P010 = 11;
        number YCRCB_P010 = 12;
        [OriginalEnumMemberName=ASTC_4x4]
        number ASTC_4X_4 = 102;
    };
    dictionary ResolutionQuality {
        number LOW = 1;
        number MEDIUM = 2;
        number HIGH = 3;
    };
    interface Size {
        attribute i32 height;
        attribute i32 width;
    };
    dictionary AlphaType {
        number UNKNOWN = 0;
        number OPAQUE = 1;
        number PREMUL = 2;
        number UNPREMUL = 3;
    };
    dictionary AntiAliasingLevel {
        number NONE = 0;
        number LOW = 1;
        number MEDIUM = 2;
        number HIGH = 3;
    };
    interface Region {
        attribute Size size;
        attribute i32 x;
        attribute i32 y;
    };
    interface PositionArea {
        attribute buffer pixels;
        attribute i32 offset;
        attribute i32 stride;
        attribute Region region;
    };
    interface ImageInfo {
        attribute Size size;
        attribute i32 density;
        attribute i32 stride;
        attribute PixelMapFormat pixelFormat;
        attribute AlphaType alphaType;
        attribute String mimeType;
        attribute boolean isHdr;
    };
    interface PixelMap {
        readonly attribute boolean isEditable;
        readonly attribute boolean isStrideAlignment;
        Promise<void> readPixelsToBuffer(buffer dst);
        void readPixelsToBuffer(buffer dst, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
        void readPixelsToBufferSync(buffer dst);
        Promise<void> readPixels(PositionArea area);
        void readPixels(PositionArea area, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
        void readPixelsSync(PositionArea area);
        Promise<void> writePixels(PositionArea area);
        void writePixels(PositionArea area, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
        void writePixelsSync(PositionArea area);
        Promise<void> writeBufferToPixels(buffer src);
        void writeBufferToPixels(buffer src, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
        void writeBufferToPixelsSync(buffer src);
        Promise<void> toSdr();
        Promise<ImageInfo> getImageInfo();
        void getImageInfo([TypeArguments="ImageInfo", TypeArguments="ImageInfo"] AsyncCallback callback_);
        ImageInfo getImageInfoSync();
        i32 getBytesNumberPerRow();
        i32 getPixelBytesNumber();
        i32 getDensity();
        void opacity(f64 rate, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
        Promise<void> opacity(f64 rate);
        void opacitySync(f64 rate);
        Promise<PixelMap> createAlphaPixelmap();
        void createAlphaPixelmap([TypeArguments="PixelMap", TypeArguments="PixelMap"] AsyncCallback callback_);
        PixelMap createAlphaPixelmapSync();
        void scale(f64 x, f64 y, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
        Promise<void> scale(f64 x, f64 y);
        void scaleSync(f64 x, f64 y);
        Promise<void> scale(f64 x, f64 y, AntiAliasingLevel level);
        void scaleSync(f64 x, f64 y, AntiAliasingLevel level);
        Promise<PixelMap> createScaledPixelMap(f64 x, f64 y, optional AntiAliasingLevel level);
        PixelMap createScaledPixelMapSync(f64 x, f64 y, optional AntiAliasingLevel level);
        void translate(f64 x, f64 y, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
        Promise<void> translate(f64 x, f64 y);
        void translateSync(f64 x, f64 y);
        void rotate(f64 angle, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
        Promise<void> rotate(f64 angle);
        void rotateSync(f64 angle);
        void flip(boolean horizontal, boolean vertical, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
        Promise<void> flip(boolean horizontal, boolean vertical);
        void flipSync(boolean horizontal, boolean vertical);
        void crop(Region region, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
        Promise<void> crop(Region region);
        void cropSync(Region region);
        colorSpaceManager.ColorSpaceManager getColorSpace();
        void marshalling(rpc.MessageSequence sequence_);
        Promise<PixelMap> unmarshalling(rpc.MessageSequence sequence_);
        void setColorSpace(colorSpaceManager.ColorSpaceManager colorSpace);
        void applyColorSpace(colorSpaceManager.ColorSpaceManager targetColorSpace, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
        Promise<void> applyColorSpace(colorSpaceManager.ColorSpaceManager targetColorSpace);
        Promise<void> convertPixelFormat(PixelMapFormat targetPixelFormat);
        void release([TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
        Promise<void> release();
        void setMemoryNameSync(String name);
    };
};