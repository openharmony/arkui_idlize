package ohos.app.ability.StartOptions;
import ohos.app.ability.contextConstant.default as contextConstant;
import ohos.multimedia.image.default as image;
import ohos.bundle.bundleManager.default as bundleManager;
[Entity=Class, DefaultExport]
interface StartOptions {
    constructor();
    [Optional]
    attribute (i32 or undefined) windowMode;
    [Optional]
    attribute (i64 or undefined) displayId;
    [Optional]
    attribute (boolean or undefined) withAnimation;
    [Optional]
    attribute (i32 or undefined) windowLeft;
    [Optional]
    attribute (i32 or undefined) windowTop;
    [Optional]
    attribute (i32 or undefined) windowWidth;
    [Optional]
    attribute (i32 or undefined) windowHeight;
    [Optional]
    attribute (boolean or undefined) windowFocused;
    [Optional]
    attribute (contextConstant.ProcessMode or undefined) processMode;
    [Optional]
    attribute (contextConstant.StartupVisibility or undefined) startupVisibility;
    [Optional]
    attribute (image.PixelMap or undefined) startWindowIcon;
    [Optional]
    attribute (String or undefined) startWindowBackgroundColor;
    [Optional]
    attribute (sequence<bundleManager.SupportWindowMode> or undefined) supportWindowModes;
    [Optional]
    attribute (i32 or undefined) minWindowWidth;
    [Optional]
    attribute (i32 or undefined) minWindowHeight;
    [Optional]
    attribute (i32 or undefined) maxWindowWidth;
    [Optional]
    attribute (i32 or undefined) maxWindowHeight;
};