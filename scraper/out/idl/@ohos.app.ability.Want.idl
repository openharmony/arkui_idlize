package ohos.app.ability.Want;
[Entity=Class, DefaultExport]
interface Want {
    constructor();
    [Optional]
    attribute (String or undefined) bundleName;
    [Optional]
    attribute (String or undefined) abilityName;
    [Optional]
    attribute (String or undefined) deviceId;
    [Optional]
    attribute (String or undefined) uri;
    [Optional]
    attribute (String or undefined) type;
    [Optional]
    attribute (i32 or undefined) flags;
    [Optional]
    attribute (String or undefined) action;
    [Optional]
    attribute (record<String, Object> or undefined) parameters;
    [Optional]
    attribute (sequence<String> or undefined) entities;
    [Optional]
    attribute (String or undefined) moduleName;
    [Optional]
    readonly attribute (record<String, i32> or undefined) fds;
};