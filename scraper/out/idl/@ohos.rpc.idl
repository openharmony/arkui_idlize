package ohos.rpc;
import ohos.base.AsyncCallback as AsyncCallback;
[DefaultExport]
namespace rpc {
    [Entity=Class]
    interface MessageSequence {
        constructor();
        static MessageSequence create();
        void reclaim();
        void writeRemoteObject(IRemoteObject obj);
        IRemoteObject readRemoteObject();
        void writeInterfaceToken(String token);
        String readInterfaceToken();
        i32 getCapacity();
        void setCapacity(i32 size);
        void writeNoException();
        void readException();
        void writeInt(i32 val);
        void writeLong(i64 val);
        void writeBoolean(boolean val);
        void writeString(String val);
        void writeParcelable(Parcelable val);
        void writeByteArray(sequence<i32> byteArray);
        void writeIntArray(sequence<i32> intArray);
        void writeDoubleArray(sequence<f64> doubleArray);
        void writeBooleanArray(sequence<boolean> booleanArray);
        void writeStringArray(sequence<String> stringArray);
        void writeParcelableArray(sequence<Parcelable> parcelableArray);
        i32 readInt();
        i64 readLong();
        boolean readBoolean();
        String readString();
        void readParcelable(Parcelable dataIn);
        void readIntArray(sequence<i32> dataIn);
        sequence<i32> readIntArray();
        void readDoubleArray(sequence<f64> dataIn);
        sequence<f64> readDoubleArray();
        void readBooleanArray(sequence<boolean> dataIn);
        sequence<boolean> readBooleanArray();
        void readStringArray(sequence<String> dataIn);
        sequence<String> readStringArray();
        void readParcelableArray(sequence<Parcelable> parcelableArray);
        static void closeFileDescriptor(i32 fd);
        void writeFileDescriptor(i32 fd);
        i32 readFileDescriptor();
        void writeAshmem(Ashmem ashmem);
        Ashmem readAshmem();
        void writeRawDataBuffer(buffer rawData, i32 size);
        buffer readRawDataBuffer(i32 size);
    };
    interface Parcelable {
        boolean marshalling(MessageSequence dataOut);
        boolean unmarshalling(MessageSequence dataIn);
    };
    interface RequestResult {
        attribute i32 errCode;
        attribute i32 code;
        attribute MessageSequence data;
        attribute MessageSequence reply;
    };
    [Entity=Class, Abstract]
    interface IRemoteObject {
        constructor();
        Promise<RequestResult> sendMessageRequest(i32 code, MessageSequence data, MessageSequence reply, MessageOption options);
        void sendMessageRequest(i32 code, MessageSequence data, MessageSequence reply, MessageOption options, [TypeArguments="RequestResult", TypeArguments="RequestResult"] AsyncCallback callback_);
        void registerDeathRecipient(DeathRecipient recipient, i32 flags);
        void unregisterDeathRecipient(DeathRecipient recipient, i32 flags);
        String getDescriptor();
        boolean isObjectDead();
    };
    interface DeathRecipient {
        void onRemoteDied();
    };
    [Entity=Class]
    interface MessageOption {
        constructor(optional i32 syncFlags, optional i32 waitTime);
        constructor(boolean isAsync);
        static attribute i32 TF_SYNC;
        static attribute i32 TF_ASYNC;
        static attribute i32 TF_WAIT_TIME;
        boolean isAsync();
        void setAsync(boolean isAsync);
    };
    [Entity=Class]
    interface Ashmem {
        constructor();
        static Ashmem create(String name, i32 size);
        static Ashmem create(Ashmem ashmem);
        i32 getAshmemSize();
        void mapReadWriteAshmem();
    };
};