        [Optional]
        attribute (BorderStyle or EdgeStyles) borderStyle;
        [Optional]
        attribute (ShadowOptions or ShadowStyle) shadow;
        [Optional]
        attribute BlurStyle backgroundBlurStyle;
    };
    typedef (Dimension or BorderRadiuses) DialogOptionsCornerRadius;
    typedef (Dimension or EdgeWidths) DialogOptionsBorderWidth;
    typedef (ResourceColor or EdgeColors) DialogOptionsBorderColor;
    typedef (BorderStyle or EdgeStyles) DialogOptionsBorderStyle;
    typedef (ShadowOptions or ShadowStyle) DialogOptionsShadow;
    interface DialogOptions: BaseDialogOptions {
        [Optional]
        attribute ResourceColor backgroundColor;
        [Optional]
        attribute DialogOptionsCornerRadius cornerRadius;
        [Optional]
        attribute Dimension width;
        [Optional]
