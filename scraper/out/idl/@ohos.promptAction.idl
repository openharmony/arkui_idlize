    };
    interface ActionMenuOptions {
        [Optional]
        attribute (String or Resource) title;
        attribute (PromptActionSingleButton or PromptActionDoubleButtons or PromptActionTripleButtons or PromptActionQuadrupleButtons or PromptActionQuintupleButtons or PromptActionSextupleButtons) buttons;
