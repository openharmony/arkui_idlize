package ohos.resourceManager;
import global.rawFileDescriptor.RawFileDescriptor as _RawFileDescriptor;
import global.resource.Resource as _Resource;
import ohos.base.AsyncCallback as _AsyncCallback;
import ohos.arkui.drawableDescriptor.DrawableDescriptor as DrawableDescriptor;
[DefaultExport]
namespace resourceManager {
    dictionary Direction {
        number DIRECTION_VERTICAL = 0;
        number DIRECTION_HORIZONTAL = 1;
    };
    dictionary DeviceType {
        number DEVICE_TYPE_PHONE = 0;
        number DEVICE_TYPE_TABLET = 1;
        number DEVICE_TYPE_CAR = 2;
        number DEVICE_TYPE_PC = 3;
        number DEVICE_TYPE_TV = 4;
        number DEVICE_TYPE_WEARABLE = 6;
        number DEVICE_TYPE_2IN1 = 7;
    };
    dictionary ScreenDensity {
        number SCREEN_SDPI = 120;
        number SCREEN_MDPI = 160;
        number SCREEN_LDPI = 240;
        number SCREEN_XLDPI = 320;
        number SCREEN_XXLDPI = 480;
        number SCREEN_XXXLDPI = 640;
    };
    dictionary ColorMode {
        number DARK = 0;
        number LIGHT = 1;
    };
    [Entity=Class]
    interface Configuration {
        constructor();
        attribute Direction direction;
        attribute String locale;
        attribute DeviceType deviceType;
        attribute ScreenDensity screenDensity;
        attribute ColorMode colorMode;
        attribute i32 mcc;
        attribute i32 mnc;
    };
    [Entity=Class]
    interface DeviceCapability {
        constructor();
        attribute ScreenDensity screenDensity;
        attribute DeviceType deviceType;
    };
    interface ResourceManager {
        void getDeviceCapability([TypeArguments="DeviceCapability", TypeArguments="DeviceCapability"] _AsyncCallback callback_);
        Promise<DeviceCapability> getDeviceCapability();
        void getConfiguration([TypeArguments="Configuration", TypeArguments="Configuration"] _AsyncCallback callback_);
        Promise<Configuration> getConfiguration();
        void getStringByName(String resName, [TypeArguments="String", TypeArguments="String"] _AsyncCallback callback_);
        Promise<String> getStringByName(String resName);
        void getStringArrayByName(String resName, [TypeArguments="sequence<String>", TypeArguments="sequence<String>"] _AsyncCallback callback_);
        Promise<sequence<String>> getStringArrayByName(String resName);
        void getMediaByName(String resName, [TypeArguments="buffer", TypeArguments="buffer"] _AsyncCallback callback_);
        void getMediaByName(String resName, i32 density, [TypeArguments="buffer", TypeArguments="buffer"] _AsyncCallback callback_);
        Promise<buffer> getMediaByName(String resName);
        Promise<buffer> getMediaByName(String resName, i32 density);
        void getMediaBase64ByName(String resName, [TypeArguments="String", TypeArguments="String"] _AsyncCallback callback_);
        void getMediaBase64ByName(String resName, i32 density, [TypeArguments="String", TypeArguments="String"] _AsyncCallback callback_);
        Promise<String> getMediaBase64ByName(String resName);
        Promise<String> getMediaBase64ByName(String resName, i32 density);
        String getStringSync(i64 resId);
        String getStringSync(i64 resId, sequence<(String or f64)> args);
        String getStringByNameSync(String resName);
        String getStringByNameSync(String resName, sequence<(String or f64)> args);
        boolean getBoolean(i64 resId);
        boolean getBooleanByName(String resName);
        i32 getInt(i64 resId);
        f64 getDouble(i64 resId);
        i32 getIntByName(String resName);
        f64 getDoubleByName(String resName);
        void getStringValue(i64 resId, [TypeArguments="String", TypeArguments="String"] _AsyncCallback callback_);
        Promise<String> getStringValue(i64 resId);
        void getStringArrayValue(i64 resId, [TypeArguments="sequence<String>", TypeArguments="sequence<String>"] _AsyncCallback callback_);
        Promise<sequence<String>> getStringArrayValue(i64 resId);
        String getIntPluralStringValueSync(i64 resId, i32 num, sequence<(String or f64)> args);
        String getIntPluralStringByNameSync(String resName, i32 num, sequence<(String or f64)> args);
        String getDoublePluralStringValueSync(i64 resId, f64 num, sequence<(String or f64)> args);
        String getDoublePluralStringByNameSync(String resName, f64 num, sequence<(String or f64)> args);
        void getMediaContent(i64 resId, [TypeArguments="buffer", TypeArguments="buffer"] _AsyncCallback callback_);
        void getMediaContent(i64 resId, i32 density, [TypeArguments="buffer", TypeArguments="buffer"] _AsyncCallback callback_);
        Promise<buffer> getMediaContent(i64 resId);
        Promise<buffer> getMediaContent(i64 resId, i32 density);
        void getMediaContentBase64(i64 resId, [TypeArguments="String", TypeArguments="String"] _AsyncCallback callback_);
        void getMediaContentBase64(i64 resId, i32 density, [TypeArguments="String", TypeArguments="String"] _AsyncCallback callback_);
        Promise<String> getMediaContentBase64(i64 resId);
        Promise<String> getMediaContentBase64(i64 resId, i32 density);
        void getRawFileContent(String path, [TypeArguments="buffer", TypeArguments="buffer"] _AsyncCallback callback_);
        Promise<buffer> getRawFileContent(String path);
        void getRawFd(String path, [TypeArguments="RawFileDescriptor", TypeArguments="RawFileDescriptor"] _AsyncCallback callback_);
        Promise<RawFileDescriptor> getRawFd(String path);
        void closeRawFd(String path, [TypeArguments="void", TypeArguments="void"] _AsyncCallback callback_);
        Promise<void> closeRawFd(String path);
        DrawableDescriptor getDrawableDescriptor(i64 resId, optional i32 density, optional i32 type);
        DrawableDescriptor getDrawableDescriptorByName(String resName, optional i32 density, optional i32 type);
        void getRawFileList(String path, [TypeArguments="sequence<String>", TypeArguments="sequence<String>"] _AsyncCallback callback_);
        Promise<sequence<String>> getRawFileList(String path);
        void getColor(i64 resId, [TypeArguments="i64", TypeArguments="i64"] _AsyncCallback callback_);
        Promise<i64> getColor(i64 resId);
        void getColorByName(String resName, [TypeArguments="i64", TypeArguments="i64"] _AsyncCallback callback_);
        Promise<i64> getColorByName(String resName);
        i64 getColorSync(i64 resId);
        i64 getColorByNameSync(String resName);
        void addResource(String path);
        void removeResource(String path);
        RawFileDescriptor getRawFdSync(String path);
        void closeRawFdSync(String path);
        sequence<String> getRawFileListSync(String path);
        buffer getRawFileContentSync(String path);
        buffer getMediaContentSync(i64 resId, optional i32 density);
        String getMediaContentBase64Sync(i64 resId, optional i32 density);
        sequence<String> getStringArrayValueSync(i64 resId);
        buffer getMediaByNameSync(String resName, optional i32 density);
        String getMediaBase64ByNameSync(String resName, optional i32 density);
        sequence<String> getStringArrayByNameSync(String resName);
        Configuration getConfigurationSync();
        DeviceCapability getDeviceCapabilitySync();
        sequence<String> getLocales(optional boolean includeSystem);
        i64 getSymbol(i64 resId);
        i64 getSymbolByName(String resName);
        boolean isRawDir(String path);
        ResourceManager getOverrideResourceManager(optional Configuration configuration);
        Configuration getOverrideConfiguration();
        void updateOverrideConfiguration(Configuration configuration);
    };
    typedef _RawFileDescriptor RawFileDescriptor;
};