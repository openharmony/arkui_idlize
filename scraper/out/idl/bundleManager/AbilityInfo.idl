package bundleManager.AbilityInfo;
import bundleManager.ApplicationInfo.ApplicationInfo as ApplicationInfo;
import bundleManager.Metadata.Metadata as Metadata;
import ohos.bundle.bundleManager.default as bundleManager;
import bundleManager.Skill.Skill as Skill;
interface AbilityInfo {
    readonly attribute String bundleName;
    readonly attribute String moduleName;
    readonly attribute String name;
    readonly attribute String label;
    readonly attribute i64 labelId;
    readonly attribute String description;
    readonly attribute i64 descriptionId;
    readonly attribute String icon;
    readonly attribute i64 iconId;
    readonly attribute String process;
    readonly attribute boolean exported;
    readonly attribute bundleManager.DisplayOrientation orientation;
    readonly attribute bundleManager.LaunchType launchType;
    readonly attribute sequence<String> permissions;
    readonly attribute sequence<String> deviceTypes;
    readonly attribute (ApplicationInfo or undefined) applicationInfo;
    readonly attribute sequence<Metadata> metadata;
    readonly attribute boolean enabled;
    readonly attribute sequence<bundleManager.SupportWindowMode> supportWindowModes;
    readonly attribute WindowSize windowSize;
    readonly attribute boolean excludeFromDock;
    readonly attribute sequence<Skill> skills;
    readonly attribute i32 appIndex;
    readonly attribute i64 orientationId;
};
interface WindowSize {
    readonly attribute f64 maxWindowRatio;
    readonly attribute f64 minWindowRatio;
    readonly attribute i64 maxWindowWidth;
    readonly attribute i64 minWindowWidth;
    readonly attribute i64 maxWindowHeight;
    readonly attribute i64 minWindowHeight;
};