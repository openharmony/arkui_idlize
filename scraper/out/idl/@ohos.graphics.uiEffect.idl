package ohos.graphics.uiEffect;
import ohos.base.AsyncCallback as AsyncCallback;
[DefaultExport]
namespace uiEffect {
    interface Filter {
        Filter pixelStretch(sequence<f64> stretchSizes, TileMode tileMode);
        Filter blur(f64 blurRadius);
        Filter waterRipple(f64 progress, i32 waveCount, f64 x, f64 y, WaterRippleMode rippleMode);
        Filter flyInFlyOutEffect(f64 degree, FlyMode flyMode);
        Filter distort(f64 distortionK);
    };
    dictionary TileMode {
        number CLAMP = 0;
        number REPEAT = 1;
        number MIRROR = 2;
        number DECAL = 3;
    };
    dictionary WaterRippleMode {
        number SMALL2MEDIUM_RECV = 0;
        number SMALL2MEDIUM_SEND = 1;
        number SMALL2SMALL = 2;
        number MINI_RECV = 3;
    };
    dictionary FlyMode {
        number BOTTOM = 0;
        number TOP = 1;
    };
    interface VisualEffect {
        VisualEffect backgroundColorBlender(BrightnessBlender blender);
    };
    typedef BrightnessBlender Blender;
    [Entity=Tuple, Synthetic]
    interface Tuple_F64_F64_F64 {
        attribute f64 value0;
        attribute f64 value1;
        attribute f64 value2;
    };
    interface BrightnessBlender {
        attribute f64 cubicRate;
        attribute f64 quadraticRate;
        attribute f64 linearRate;
        attribute f64 degree;
        attribute f64 saturation;
        attribute Tuple_F64_F64_F64 positiveCoefficient;
        attribute Tuple_F64_F64_F64 negativeCoefficient;
        attribute f64 fraction;
    };
};