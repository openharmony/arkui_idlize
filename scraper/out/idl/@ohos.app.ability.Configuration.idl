package ohos.app.ability.Configuration;
import ohos.app.ability.ConfigurationConstant.default as ConfigurationConstant;
interface Configuration {
    [Optional]
    attribute String language;
    [Optional]
    attribute ConfigurationConstant.ColorMode colorMode;
    [Optional]
    attribute ConfigurationConstant.Direction direction;
    [Optional]
    attribute ConfigurationConstant.ScreenDensity screenDensity;
    [Optional]
    attribute i64 displayId;
    [Optional]
    attribute boolean hasPointerDevice;
    [Optional]
    attribute f64 fontSizeScale;
    [Optional]
    attribute f64 fontWeightScale;
    [Optional]
    attribute String mcc;
    [Optional]
    attribute String mnc;
};