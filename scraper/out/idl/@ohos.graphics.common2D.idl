package ohos.graphics.common2D;
[DefaultExport]
namespace common2D {
    interface Color {
        attribute i32 alpha;
        attribute i32 red;
        attribute i32 green;
        attribute i32 blue;
    };
    interface Rect {
        attribute f64 left;
        attribute f64 top;
        attribute f64 right;
        attribute f64 bottom;
    };
};