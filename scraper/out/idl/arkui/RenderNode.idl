import arkui.component.enums.BorderStyle as BorderStyle;
[Entity=Class]
interface RenderNode {
    constructor();
    [Accessor=Setter]
    attribute number backgroundColor;
    [Accessor=Getter]
    attribute number backgroundColor;
    [Accessor=Setter]
    attribute boolean clipToFrame;
    [Accessor=Getter]
    attribute boolean clipToFrame;
    [Accessor=Setter]
    attribute number opacity;
    [Accessor=Getter]
    attribute number opacity;
    [Accessor=Setter]
    attribute Size size;
    [Accessor=Getter]
    attribute Size size;
    [Accessor=Setter]
    attribute Position position;
    [Accessor=Getter]
    attribute Position position;
    [Accessor=Setter]
    attribute Frame frame;
    [Accessor=Getter]
    attribute Frame frame;
    [Accessor=Setter]
    attribute Pivot pivot;
    [Accessor=Getter]
    attribute Pivot pivot;
    [Accessor=Setter]
    attribute Scale scale;
    [Accessor=Getter]
    attribute Scale scale;
    [Accessor=Setter]
    attribute Translation translation;
    [Accessor=Getter]
    attribute Translation translation;
    [Accessor=Setter]
    attribute Rotation rotation;
    [Accessor=Getter]
    attribute Rotation rotation;
    [Accessor=Setter]
    attribute Matrix4 transform;
    [Accessor=Getter]
    attribute Matrix4 transform;
    [Accessor=Setter]
    attribute number shadowColor;
    [Accessor=Getter]
    attribute number shadowColor;
    [Accessor=Setter]
    attribute Offset shadowOffset;
    [Accessor=Getter]
