    [Accessor=Setter]
    attribute String label;
    [Accessor=Getter]
    attribute String label;
    [Accessor=Setter]
    attribute number shadowAlpha;
    [Accessor=Getter]
    attribute number shadowAlpha;
    [Accessor=Setter]
    attribute number shadowElevation;
    [Accessor=Getter]
    attribute number shadowElevation;
    [Accessor=Setter]
    attribute number shadowRadius;
    [Accessor=Getter]
    attribute number shadowRadius;
    [Accessor=Setter]
    attribute [TypeArguments="BorderStyle", TypeArguments="BorderStyle"] Edges borderStyle;
    [Accessor=Getter]
    attribute [TypeArguments="BorderStyle", TypeArguments="BorderStyle"] Edges borderStyle;
    [Accessor=Setter]
    attribute [TypeArguments="number", TypeArguments="number"] Edges borderWidth;
    [Accessor=Getter]
    attribute [TypeArguments="number", TypeArguments="number"] Edges borderWidth;
    [Accessor=Setter]
    attribute [TypeArguments="number", TypeArguments="number"] Edges borderColor;
    [Accessor=Getter]
