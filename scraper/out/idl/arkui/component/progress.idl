interface ProgressOptions {
    attribute number value;
    [Optional]
    attribute number total;
    [Optional]
    attribute ProgressType type;
};
dictionary ProgressType {
    [OriginalEnumMemberName=Linear]
    number LINEAR = 0;
    [OriginalEnumMemberName=Ring]
    number RING = 1;
    [OriginalEnumMemberName=Eclipse]
    number ECLIPSE = 2;
    [OriginalEnumMemberName=ScaleRing]
    number SCALE_RING = 3;
    [OriginalEnumMemberName=Capsule]
