    [CommonMethod]
    attribute ((LinearStyleOptions or RingStyleOptions or CapsuleStyleOptions or ProgressStyleOptions) or undefined) style;
    [CommonMethod]
    attribute (boolean or undefined) privacySensitive;
    [CommonMethod]
    attribute ([TypeArguments="ProgressConfiguration", TypeArguments="ProgressConfiguration"] ContentModifier or undefined) contentModifier;
    [CommonMethod]
