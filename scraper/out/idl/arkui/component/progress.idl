    number PROGRESSING = 1;
};
interface ProgressStyleOptions: CommonProgressStyleOptions {
    [Optional]
    attribute Length strokeWidth;
    [Optional]
    attribute number scaleCount;
    [Optional]
    attribute Length scaleWidth;
};
interface CommonProgressStyleOptions {
    [Optional]
    attribute boolean enableSmoothEffect;
};
interface ScanEffectOptions {
