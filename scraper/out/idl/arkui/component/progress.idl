    attribute Length borderWidth;
    [Optional]
    attribute Font font;
    [Optional]
    attribute ResourceColor fontColor;
    [Optional]
    attribute boolean showDefaultPercentage;
    [Optional]
    attribute LengthMetrics borderRadius;
};
dictionary ProgressStyle {
    [OriginalEnumMemberName=Linear]
    number LINEAR = 0;
    [OriginalEnumMemberName=Ring]
    number RING = 1;
    [OriginalEnumMemberName=Eclipse]
    number ECLIPSE = 2;
    [OriginalEnumMemberName=ScaleRing]
    number SCALE_RING = 3;
    [OriginalEnumMemberName=Capsule]
    number CAPSULE = 4;
};
interface ProgressStyleMap {
};
[Component]
interface ProgressAttribute: CommonMethod {
    [CommonMethod]
    attribute (number or undefined) value;
    [CommonMethod]
