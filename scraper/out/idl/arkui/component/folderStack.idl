import arkui.component.enums.Alignment as Alignment;
import arkui.component.enums.AppRotation as AppRotation;
import arkui.stateManagement.runtime.memo as memo;
import arkui.stateManagement.runtime.ComponentBuilder as ComponentBuilder;
import arkui.component.common.AttributeModifier as AttributeModifier;
import arkui.component.common.CommonMethod as CommonMethod;
typedef window.WindowStatusType WindowStatusType;
interface FolderStackOptions {
    [Optional]
    attribute sequence<String> upperItems;
};
interface OnFoldStatusChangeInfo {
    attribute FoldStatus foldStatus;
};
callback OnFoldStatusChangeCallback = void (OnFoldStatusChangeInfo event);
callback OnHoverStatusChangeCallback = void (HoverEventParam param);
[Component]
interface FolderStackAttribute: CommonMethod {
    [CommonMethod]
    attribute (Alignment or undefined) alignContent;
    [CommonMethod]
    attribute (OnFoldStatusChangeCallback or undefined) onFolderStateChange;
    [CommonMethod]
    attribute (OnHoverStatusChangeCallback or undefined) onHoverStatusChange;
    [CommonMethod]
    attribute (boolean or undefined) enableAnimation;
