    attribute (boolean or undefined) autoHalfFold;
    [CommonMethod]
    attribute (([TypeArguments="FolderStackAttribute", TypeArguments="FolderStackAttribute"] AttributeModifier or [TypeArguments="CommonMethod", TypeArguments="CommonMethod"] AttributeModifier) or undefined) attributeModifier;
};
interface HoverEventParam {
    attribute FoldStatus foldStatus;
    attribute boolean isHoverMode;
    attribute AppRotation appRotation;
    attribute WindowStatusType windowStatusType;
};
[Synthetic]
callback Callback_Void = void ();
[ComponentInterface]
interface FolderStackInterface {
    [Annotations=memo, CallSignature]
    ([Annotations=memo, CallSignature] FolderStackAttribute) invoke(optional FolderStackOptions options);
};