    readonly attribute number actualBoundingBoxRight;
    readonly attribute number alphabeticBaseline;
    readonly attribute number emHeightAscent;
    readonly attribute number emHeightDescent;
    readonly attribute number fontBoundingBoxAscent;
    readonly attribute number fontBoundingBoxDescent;
    readonly attribute number hangingBaseline;
    readonly attribute number ideographicBaseline;
    readonly attribute number width;
    readonly attribute number height;
};
