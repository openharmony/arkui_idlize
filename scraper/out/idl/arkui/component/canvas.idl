    void onOnAttach(Callback_Void callback_);
    [DtsTag="'onAttach'", DtsName="off", Throws]
    void offOnAttach(optional Callback_Void callback_);
    [DtsTag="'onDetach'", DtsName="on"]
    void onOnDetach(Callback_Void callback_);
    [DtsTag="'onDetach'", DtsName="off"]
    void offOnDetach(optional Callback_Void callback_);
};
