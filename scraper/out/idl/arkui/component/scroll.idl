dictionary ScrollDirection {
    [OriginalEnumMemberName=Vertical]
    number VERTICAL = 0;
    [OriginalEnumMemberName=Horizontal]
    number HORIZONTAL = 1;
    [OriginalEnumMemberName=None]
    number NONE = 2;
};
dictionary ScrollAlign {
    number START = 0;
    number CENTER = 1;
    number END = 2;
    number AUTO = 3;
};
interface OffsetResult {
    attribute number xOffset;
    attribute number yOffset;
};
interface ScrollEdgeOptions {
    [Optional]
    attribute number velocity;
};
interface ScrollToIndexOptions {
    [Optional]
    attribute LengthMetrics extraOffset;
};
