callback ScrollOnScrollCallback = void (number xOffset, number yOffset, ScrollState scrollState);
callback ScrollOnWillScrollCallback = (OffsetResult or undefined) (number xOffset, number yOffset, ScrollState scrollState, ScrollSource scrollSource);
[Synthetic]
callback Callback_Void = void ();
