    [Optional]
    attribute boolean canOverScroll;
};
interface OffsetOptions {
    [Optional]
    attribute Dimension xOffset;
    [Optional]
    attribute Dimension yOffset;
};
[Entity=Class]
interface Scroller {
    constructor();
    void scrollTo(ScrollOptions options);
    void scrollEdge(Edge value, optional ScrollEdgeOptions options);
    void fling(number velocity);
    void scrollPage(ScrollPageOptions value);
    OffsetResult currentOffset();
    void scrollToIndex(number value, optional boolean smooth, optional ScrollAlign align, optional ScrollToIndexOptions options);
    void scrollBy(Length dx, Length dy);
    boolean isAtEnd();
    RectResult getItemRect(number index);
    number getItemIndex(number x, number y);
};
interface ScrollOptions {
    attribute (number or String) xOffset;
    attribute (number or String) yOffset;
    [Optional]
    attribute (ScrollAnimationOptions or boolean) animation;
};
interface ScrollPageOptions {
    attribute boolean next;
    [Optional]
    attribute boolean animation;
};
interface ScrollSnapOptions {
    attribute ScrollSnapAlign snapAlign;
    [Optional]
