package arkui.component.pluginComponent;
import arkui.component.units.VoidCallback as VoidCallback;
import arkui.stateManagement.runtime.memo as memo;
import arkui.stateManagement.runtime.ComponentBuilder as ComponentBuilder;
import arkui.component.common.AttributeModifier as AttributeModifier;
import arkui.component.common.CommonMethod as CommonMethod;
interface PluginComponentTemplate {
    attribute (String or undefined) source;
    attribute (String or undefined) bundleName;
};
typedef (Object or undefined) RecordData;
interface PluginComponentOptions {
    attribute PluginComponentTemplate template;
    attribute RecordData data;
};
interface PluginErrorData {
    attribute i32 errcode;
    attribute String msg;
};
callback PluginErrorCallback = void (PluginErrorData info);
[Component]
interface PluginComponentAttribute: CommonMethod {
    [CommonMethod]
    attribute (VoidCallback or undefined) onComplete;
    [CommonMethod]
    attribute (PluginErrorCallback or undefined) onError;
    [CommonMethod]
    attribute (([TypeArguments="PluginComponentAttribute", TypeArguments="PluginComponentAttribute"] AttributeModifier or [TypeArguments="CommonMethod", TypeArguments="CommonMethod"] AttributeModifier) or undefined) attributeModifier;
};
[Synthetic]
callback Callback_Void = void ();
[ComponentInterface]
interface PluginComponentInterface {
    [Annotations=memo, CallSignature]
    ([Annotations=memo, CallSignature] PluginComponentAttribute) invoke(PluginComponentOptions options);
};