package arkui.component.imageCommon;
import arkui.stateManagement.runtime.memo as memo;
import arkui.stateManagement.runtime.ComponentBuilder as ComponentBuilder;
import arkui.component.common.AttributeModifier as AttributeModifier;
import arkui.component.common.CommonMethod as CommonMethod;
dictionary ImageAnalyzerType {
    number SUBJECT = 0;
    number TEXT = 1;
    number OBJECT_LOOKUP = 2;
};
[Entity=Class]
interface ImageAnalyzerController {
    constructor();
    sequence<ImageAnalyzerType> getImageAnalyzerSupportTypes();
};
interface ImageAnalyzerConfig {
    attribute sequence<ImageAnalyzerType> types;
};
interface ImageAIOptions {
    [Optional]
    attribute sequence<ImageAnalyzerType> types;
    [Optional]
    attribute ImageAnalyzerController aiController;
};