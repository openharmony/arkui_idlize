package arkui.component.focus;
import arkui.Graphics.LengthMetrics as LengthMetrics;
import arkui.Graphics.ColorMetrics as ColorMetrics;
interface FocusBoxStyle {
    [Optional]
    attribute LengthMetrics margin;
    [Optional]
    attribute ColorMetrics strokeColor;
    [Optional]
    attribute LengthMetrics strokeWidth;
};
dictionary FocusPriority {
    number AUTO = 0;
    number PRIOR = 2000;
    number PREVIOUS = 3000;
};
dictionary KeyProcessingMode {
    number FOCUS_NAVIGATION = 0;
    number ANCESTOR_EVENT = 1;
};