    [CommonMethod]
    attribute (([TypeArguments="LineAttribute", TypeArguments="LineAttribute"] AttributeModifier or [TypeArguments="CommonMethod", TypeArguments="CommonMethod"] AttributeModifier) or undefined) attributeModifier;
};
[Synthetic]
callback Callback_Void = void ();
[ComponentInterface]
interface LineInterface {
    [Annotations=memo, CallSignature]
    ([Annotations=memo, CallSignature] LineAttribute) invoke(optional LineOptions options);
};