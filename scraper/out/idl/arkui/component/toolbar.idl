package arkui.component.toolbar;
dictionary ToolBarItemPlacement {
    number TOP_BAR_LEADING = 0;
    number TOP_BAR_TRAILING = 1;
};
interface ToolBarItemOptions {
    [Optional]
    attribute ToolBarItemPlacement placement;
};
[Entity=Class, Component]
interface ToolBarItemAttribute {
    constructor();
};
[Synthetic]
callback Callback_Void = void ();
[ComponentInterface]
interface ToolBarItemInterface {
    [Annotations=memo, CallSignature]
    ([Annotations=memo, CallSignature] ToolBarItemAttribute) invoke(optional ToolBarItemOptions options);
};