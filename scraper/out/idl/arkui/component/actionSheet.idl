interface SheetInfo {
    attribute (String or Resource) title;
    [Optional]
    attribute (String or Resource) icon;
    attribute VoidCallback action;
};
interface DismissDialogAction {
    attribute DismissReason reason;
    void dismiss();
};
interface ActionSheetButtonOptions {
    [Optional]
    attribute boolean enabled;
    [Optional]
    attribute boolean defaultFocus;
    [Optional]
    attribute DialogButtonStyle style;
    attribute (String or Resource) value;
    attribute VoidCallback action;
};
interface ActionSheetOffset {
    attribute (number or String or Resource) dx;
    attribute (number or String or Resource) dy;
};
[Synthetic]
callback Callback_DismissDialogAction_Void = void (DismissDialogAction value0);
[Synthetic]
callback Callback_Void = void ();
interface ActionSheetOptions {
    attribute (String or Resource) title;
    [Optional]
    attribute ResourceStr subtitle;
    attribute (String or Resource) message;
    [Optional]
    attribute ActionSheetButtonOptions confirm;
    [Optional]
    attribute VoidCallback cancel;
    attribute sequence<SheetInfo> sheets;
    [Optional]
    attribute boolean autoCancel;
    [Optional]
    attribute DialogAlignment alignment;
    [Optional]
    attribute ActionSheetOffset offset;
    [Optional]
    attribute Rectangle maskRect;
    [Optional]
    attribute boolean showInSubWindow;
    [Optional]
    attribute boolean isModal;
    [Optional]
    attribute ResourceColor backgroundColor;
    [Optional]
    attribute BlurStyle backgroundBlurStyle;
    [Optional]
    attribute BackgroundBlurStyleOptions backgroundBlurStyleOptions;
    [Optional]
    attribute BackgroundEffectOptions backgroundEffect;
    [Optional]
    attribute Callback_DismissDialogAction_Void onWillDismiss;
    [Optional]
    attribute TransitionEffect transition;
    [Optional]
    attribute (Dimension or BorderRadiuses or LocalizedBorderRadiuses) cornerRadius;
    [Optional]
    attribute Dimension width;
    [Optional]
    attribute Dimension height;
    [Optional]
    attribute (Dimension or EdgeWidths or LocalizedEdgeWidths) borderWidth;
    [Optional]
    attribute (ResourceColor or EdgeColors or LocalizedEdgeColors) borderColor;
    [Optional]
    attribute (BorderStyle or EdgeStyles) borderStyle;
    [Optional]
    attribute (ShadowOptions or ShadowStyle) shadow;
    [Optional]
    attribute boolean enableHoverMode;
    [Optional]
    attribute HoverModeAreaType hoverModeArea;
    [Optional]
    attribute Callback_Void onDidAppear;
    [Optional]
    attribute Callback_Void onDidDisappear;
    [Optional]
    attribute Callback_Void onWillAppear;
    [Optional]
    attribute Callback_Void onWillDisappear;
    [Optional]
    attribute LevelMode levelMode;
    [Optional]
    attribute number levelUniqueId;
    [Optional]
    attribute ImmersiveMode immersiveMode;
    [Optional]
    attribute LevelOrder levelOrder;
};