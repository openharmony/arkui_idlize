package arkui.component.linearindicator;
import arkui.component.common.CommonMethod as CommonMethod;
import arkui.component.common.Optional as Optional;
import arkui.component.units.ColorMetrics as ColorMetrics;
import arkui.component.units.LengthMetrics as LengthMetrics;
import arkui.stateManagement.runtime.memo as memo;
import arkui.stateManagement.runtime.ComponentBuilder as ComponentBuilder;
import arkui.component.common.AttributeModifier as AttributeModifier;
[Entity=Class]
interface LinearIndicatorController {
    constructor();
    void setProgress(number index, number progress);
    void start(optional LinearIndicatorStartOptions options);
    void pause();
    void stop();
};
interface LinearIndicatorStartOptions {
    [Optional]
    attribute number interval;
    [Optional]
    attribute number duration;
};
interface LinearIndicatorStyle {
    [Optional]
    attribute LengthMetrics space;
    [Optional]
    attribute LengthMetrics strokeWidth;
    [Optional]
    attribute LengthMetrics strokeRadius;
    [Optional]
    attribute ColorMetrics trackBackgroundColor;
    [Optional]
    attribute ColorMetrics trackColor;
};
[Component]
interface LinearIndicatorAttribute: CommonMethod {
    [CommonMethod]
    attribute (LinearIndicatorStyle or undefined) indicatorStyle;
    [CommonMethod]
    attribute (boolean or undefined) indicatorLoop;
    [CommonMethod]
    attribute (OnLinearIndicatorChangeCallback or undefined) onChange;
    [CommonMethod]
    attribute (([TypeArguments="LinearIndicatorAttribute", TypeArguments="LinearIndicatorAttribute"] AttributeModifier or [TypeArguments="CommonMethod", TypeArguments="CommonMethod"] AttributeModifier) or undefined) attributeModifier;
};
callback OnLinearIndicatorChangeCallback = void (number index, number progress);
[Synthetic]
callback Callback_Void = void ();
[ComponentInterface]
interface LinearIndicatorInterface {
    [Annotations=memo, CallSignature]
    ([Annotations=memo, CallSignature] LinearIndicatorAttribute) invoke(optional number count, optional LinearIndicatorController controller);
};