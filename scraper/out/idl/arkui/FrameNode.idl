interface LayoutConstraint {
    attribute Size maxSize;
    attribute Size minSize;
    attribute Size percentReference;
};
interface CrossLanguageOptions {
    [Optional]
    attribute boolean attributeSetting;
};
dictionary ExpandMode {
    number NOT_EXPAND = 0;
    number EXPAND = 1;
    number LAZY_EXPAND = 2;
};
[Entity=Class]
interface FrameNode {
    constructor(UIContext uiContext);
    [Accessor=Getter]
    attribute UICommonEvent commonEvent;
    [Accessor=Getter]
    attribute UIGestureEvent gestureEvent;
    [Accessor=Getter]
    attribute CommonAttribute commonAttribute;
    (RenderNode or undefined) getRenderNode();
    boolean isModifiable();
    void appendChild(FrameNode node);
    void insertChildAfter(FrameNode child, (FrameNode or undefined) sibling);
    void removeChild(FrameNode node);
    void clearChildren();
    (FrameNode or undefined) getChild(number index, optional (ExpandMode or undefined) expandMode);
    number getFirstChildIndexWithoutExpand();
    number getLastChildIndexWithoutExpand();
    (FrameNode or undefined) getFirstChild();
    (FrameNode or undefined) getNextSibling();
    (FrameNode or undefined) getPreviousSibling();
    (FrameNode or undefined) getParent();
    number getChildrenCount();
    void moveTo(FrameNode targetParent, optional number index);
    void dispose();
    Position getPositionToWindow();
    boolean isDisposed();
    Position getPositionToParent();
    Size getMeasuredSize();
    Position getLayoutPosition();
    ([TypeArguments="LengthMetrics"] Edges) getUserConfigBorderWidth();
    ([TypeArguments="LengthMetrics"] Edges) getUserConfigPadding();
    ([TypeArguments="LengthMetrics"] Edges) getUserConfigMargin();
    ([TypeArguments="LengthMetrics"] SizeT) getUserConfigSize();
    String getId();
    number getUniqueId();
    String getNodeType();
    number getOpacity();
    boolean isVisible();
    boolean isClipToFrame();
    boolean isAttached();
    Object getInspectorInfo();
    CustomProperty getCustomProperty(String name);
    void onMeasure(LayoutConstraint constraint);
    void onLayout(Position position);
    void setMeasuredSize(Size size);
    void setLayoutPosition(Position position);
    void measure(LayoutConstraint constraint);
    void layout(Position position);
    void setNeedsLayout();
    void invalidate();
    Position getPositionToScreen();
    Position getGlobalPositionOnDisplay();
    Position getPositionToWindowWithTransform();
    Position getPositionToParentWithTransform();
    Position getPositionToScreenWithTransform();
    void disposeTree();
    [TypeParameters="T", TypeParameters="T"]
    void addComponentContent([TypeArguments="T", TypeArguments="T"] ComponentContent content);
    void setCrossLanguageOptions(CrossLanguageOptions value);
    CrossLanguageOptions getCrossLanguageOptions();
    void recycle();
    void reuse();
    boolean isTransferred();
};
