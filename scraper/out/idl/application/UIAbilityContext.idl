package application.UIAbilityContext;
import bundleManager.AbilityInfo.AbilityInfo as AbilityInfo;
import ohos.arkui.stateManagement.LocalStorage as LocalStorage;
import ohos.multimedia.image.default as image;
import ohos.app.ability.AtomicServiceOptions.default as AtomicServiceOptions;
import ohos.app.ability.ConfigurationConstant.default as ConfigurationConstant;
import ohos.app.ability.UIAbility.Caller as Caller;
import ohos.app.ability.OpenLinkOptions.default as OpenLinkOptions;
import bundleManager.HapModuleInfo.HapModuleInfo as HapModuleInfo;
import ability.connectOptions.ConnectOptions as ConnectOptions;
import ohos.base.AsyncCallback as AsyncCallback;
import ohos.window.default as window;
import ability.abilityResult.AbilityResult as AbilityResult;
import application.Context.default as Context;
import ohos.app.ability.Configuration.Configuration as Configuration;
import ohos.app.ability.StartOptions.default as StartOptions;
import ohos.app.ability.Want.default as Want;
import application.AbilityStartCallback.default as AbilityStartCallback;
[Entity=Class, DefaultExport]
interface UIAbilityContext: [Extends] Context {
    constructor();
    attribute AbilityInfo abilityInfo;
    attribute HapModuleInfo currentHapModuleInfo;
    attribute Configuration config;
    attribute window.WindowStage windowStage;
    void startAbility(Want want, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    void startAbility(Want want, StartOptions options, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    Promise<void> startAbility(Want want, optional StartOptions options);
    Promise<void> openLink(String link, optional OpenLinkOptions options, optional [TypeArguments="AbilityResult", TypeArguments="AbilityResult"] AsyncCallback callback_);
    Promise<Caller> startAbilityByCall(Want want);
    void startAbilityForResult(Want want, [TypeArguments="AbilityResult", TypeArguments="AbilityResult"] AsyncCallback callback_);
    void startAbilityForResult(Want want, StartOptions options, [TypeArguments="AbilityResult", TypeArguments="AbilityResult"] AsyncCallback callback_);
    Promise<AbilityResult> startAbilityForResult(Want want, optional StartOptions options);
    void startServiceExtensionAbility(Want want, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    Promise<void> startServiceExtensionAbility(Want want);
    void startServiceExtensionAbilityWithAccount(Want want, i32 accountId, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    Promise<void> startServiceExtensionAbilityWithAccount(Want want, i32 accountId);
    void stopServiceExtensionAbility(Want want, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    Promise<void> stopServiceExtensionAbility(Want want);
    void stopServiceExtensionAbilityWithAccount(Want want, i32 accountId, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    Promise<void> stopServiceExtensionAbilityWithAccount(Want want, i32 accountId);
    void terminateSelf([TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    Promise<void> terminateSelf();
    void terminateSelfWithResult(AbilityResult parameter, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    Promise<void> terminateSelfWithResult(AbilityResult parameter);
    i64 connectServiceExtensionAbility(Want want, ConnectOptions options);
    i64 connectServiceExtensionAbilityWithAccount(Want want, i32 accountId, ConnectOptions options);
    void disconnectServiceExtensionAbility(i64 connection, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    Promise<void> disconnectServiceExtensionAbility(i64 connection);
    void setMissionLabel(String label, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    Promise<void> setMissionLabel(String label);
    void setMissionIcon(image.PixelMap icon, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    Promise<void> setMissionIcon(image.PixelMap icon);
    void restoreWindowStage(LocalStorage localStorage);
    boolean isTerminating();
    void reportDrawnCompleted([TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    void startAbilityByType(String type, record<String, Object> wantParam, AbilityStartCallback abilityStartCallback, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    Promise<void> startAbilityByType(String type, record<String, Object> wantParam, AbilityStartCallback abilityStartCallback);
    void requestModalUIExtension(Want pickerWant, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    Promise<void> requestModalUIExtension(Want pickerWant);
    Promise<AbilityResult> openAtomicService(String appId, optional AtomicServiceOptions options);
    Promise<void> moveAbilityToBackground();
    Promise<void> showAbility();
    Promise<void> hideAbility();
    Promise<void> setAbilityInstanceInfo(String label, image.PixelMap icon);
    Promise<void> revokeDelegator();
    void setColorMode(ConfigurationConstant.ColorMode colorMode);
    Promise<void> startAppServiceExtensionAbility(Want want);
    Promise<void> stopAppServiceExtensionAbility(Want want);
    i64 connectAppServiceExtensionAbility(Want want, ConnectOptions callback_);
    Promise<void> disconnectAppServiceExtensionAbility(i64 connection);
};