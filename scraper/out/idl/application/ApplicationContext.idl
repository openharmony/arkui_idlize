package application.ApplicationContext;
import application.Context.default as Context;
import ohos.base.AsyncCallback as AsyncCallback;
import application.ProcessInformation.ProcessInformation as ProcessInformation;
import ohos.app.ability.ConfigurationConstant.default as ConfigurationConstant;
import ohos.app.ability.Want.default as Want;
import ohos.app.ability.EnvironmentCallback.default as EnvironmentCallback;
import ohos.app.ability.AbilityLifecycleCallback.default as AbilityLifecycleCallback;
import ohos.app.ability.InteropAbilityLifecycleCallback.default as InteropAbilityLifecycleCallback;
import ohos.app.ability.ApplicationStateChangeCallback.default as ApplicationStateChangeCallback;
[Entity=Class, DefaultExport]
interface ApplicationContext: [Extends] Context {
    constructor();
    [DtsTag="'abilityLifecycle'", DtsName="on"]
    i32 onAbilityLifecycle(AbilityLifecycleCallback callback_);
    [DtsTag="'interopAbilityLifecycle'", DtsName="on"]
    void onInteropAbilityLifecycle(InteropAbilityLifecycleCallback callback_);
    [DtsTag="'abilityLifecycle'", DtsName="off"]
    void offAbilityLifecycle(i32 callbackId, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    [DtsTag="'abilityLifecycle'", DtsName="off"]
    Promise<void> offAbilityLifecycle(i32 callbackId);
    [DtsTag="'interopAbilityLifecycle'", DtsName="off"]
    void offInteropAbilityLifecycle(optional InteropAbilityLifecycleCallback callback_);
    [DtsTag="'environment'", DtsName="on"]
    i32 onEnvironment(EnvironmentCallback callback_);
    [DtsTag="'environment'", DtsName="off"]
    void offEnvironment(i32 callbackId, [TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    [DtsTag="'environment'", DtsName="off"]
    Promise<void> offEnvironment(i32 callbackId);
    [DtsTag="'applicationStateChange'", DtsName="on"]
    void onApplicationStateChange(ApplicationStateChangeCallback callback_);
    [DtsTag="'applicationStateChange'", DtsName="off"]
    void offApplicationStateChange(optional ApplicationStateChangeCallback callback_);
    Promise<sequence<ProcessInformation>> getRunningProcessInformation();
    void getRunningProcessInformation([TypeArguments="sequence<ProcessInformation>", TypeArguments="sequence<ProcessInformation>"] AsyncCallback callback_);
    Promise<void> killAllProcesses();
    Promise<void> killAllProcesses(boolean clearPageStack);
    void killAllProcesses([TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    void setColorMode(ConfigurationConstant.ColorMode colorMode);
    void setLanguage(String language);
    Promise<void> clearUpApplicationData();
    void clearUpApplicationData([TypeArguments="void", TypeArguments="void"] AsyncCallback callback_);
    void restartApp(Want want);
    Promise<void> preloadUIExtensionAbility(Want want);
    void setSupportedProcessCache(boolean isSupported);
    void setFont(String font);
    i32 getCurrentAppCloneIndex();
    void setFontSizeScale(f64 fontSizeScale);
    String getCurrentInstanceKey();
    Promise<sequence<String>> getAllRunningInstanceKeys();
};