package application.Context;
import application.EventHub.default as EventHub;
import bundleManager.ApplicationInfo.ApplicationInfo as ApplicationInfo;
import application.ApplicationContext.default as ApplicationContext;
import ohos.base.AsyncCallback as AsyncCallback;
import application.BaseContext.default as BaseContext;
import ohos.resourceManager.default as resmgr;
import ohos.app.ability.contextConstant.default as contextConstant;
[Entity=Class, DefaultExport]
interface Context: [Extends] BaseContext {
    constructor();
    attribute resmgr.ResourceManager resourceManager;
    attribute ApplicationInfo applicationInfo;
    attribute String cacheDir;
    attribute String tempDir;
    attribute String filesDir;
    attribute String databaseDir;
    attribute String preferencesDir;
    attribute String bundleCodeDir;
    attribute String distributedFilesDir;
    attribute String resourceDir;
    attribute String cloudFileDir;
    attribute EventHub eventHub;
    [Accessor=Getter]
    attribute contextConstant.AreaMode area;
    [Accessor=Setter]
    attribute contextConstant.AreaMode area;
    attribute String processName;
    ApplicationContext getApplicationContext();
    void getGroupDir(String dataGroupID, [TypeArguments="String", TypeArguments="String"] AsyncCallback callback_);
    Promise<String> getGroupDir(String dataGroupID);
    resmgr.ResourceManager createModuleResourceManager(String bundleName, String moduleName);
    Context createAreaModeContext(contextConstant.AreaMode areaMode);
    Context createDisplayContext(i64 displayId);
};